# Settings for the steer lab workflow. SCRIPT picks the method: lab (directions from contrastive
# sentences, concepts.json) or sae (features of a sparse autoencoder, sae-concepts.json).
# Leave EXPORT_LAYER empty to only explore; set it to export steer.json, test it and commit it.
SCRIPT=sae
LAYERS=16,18
COEFS=0.4,0.8,1.2
# sae: which SAE, which concepts to search, how many features to show per concept
SAE_REPO=HuggingAnalist/sae-qwen2.5-0.5B-res
CONCEPTS=golden_gate,dogs,nyc,friends,lions,columbia
TOP=4
EXPORT_FEATURE=
EXPORT_CONCEPT=
# lab: the concept, an optional second one mixed in, and the mixes to try
CONCEPT=chandler
MIX_CONCEPT=sarcasm
MIXES=0,0.5
EXPORT_MIX=0
# export
EXPORT_LAYER=
MAX=0.7
DEFAULT=0.65
