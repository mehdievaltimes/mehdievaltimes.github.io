---
import { render } from 'astro:content';
import { type Entry, isShort, excerpt, fmtDate, readingTime } from '../lib';

interface Props { entry: Entry }
const { entry } = Astro.props;
const href = `/posts/${entry.id}/`;
const short = isShort(entry);
const { Content } = short ? await render(entry) : { Content: null };
---
<li class:list={['entry', { note: short }]}>
  <div class="meta">
    <a href={href}><time datetime={entry.data.date.toISOString()}>{fmtDate(entry.data.date)}</time></a>
    {!short && <span>· {readingTime(entry)}</span>}
    {entry.data.draft && <span class="tag-draft">· draft</span>}
  </div>
  {entry.data.title && <h2><a href={href}>{entry.data.title}</a></h2>}
  {short && Content ? (
    <div class="prose"><Content /></div>
  ) : (
    <p class="excerpt">{excerpt(entry)}</p>
  )}
</li>
