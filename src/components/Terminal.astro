---
// A small fake shell on the homepage. Its files, and the git repo in ~/.ctf, live in ./terminal/fs.ts;
// its words (8-ball, man pages) in ./terminal/text.ts. ~/writing and ~/reading are filled in at build time
// from the content collections, so the terminal can browse the site.
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { getEntries } from '../lib';

const posts = await getEntries();
// Same rule as /reading: coursework only shows in `npm run dev`.
const reading = await getCollection('reading', ({ data }) => import.meta.env.DEV || data.kind !== 'course');
const raw = (path: string | undefined, fallback = '') => {
  try { return path ? fs.readFileSync(path, 'utf8').trim() : fallback; } catch { return fallback; }
};
const data = {
  writing: Object.fromEntries(posts.map((e) => [`${e.id}.md`, raw(e.filePath, e.body ?? '')])),
  reading: Object.fromEntries(reading.map((e) => [`${e.id}.yml`, raw(e.filePath)])),
  readingItems: reading.reduce((n, e) => n + e.data.items.length, 0),
};
// JSON inside a <script> tag: escape '<' so a post can't close the tag.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<div class="term-slot" id="term-slot">
<section class="term" id="term" aria-label="Terminal">
  <div class="term-bar">
    <span></span><span></span><span></span><b id="term-title">guest@mehdi: ~</b>
    <button type="button" class="term-shrink" id="term-shrink" title="Exit full screen (Esc)"><span class="k">esc</span><span class="t">done</span></button>
  </div>
  <div class="term-body" id="term-body">
    <div id="term-out" role="log" aria-live="polite"></div>
    <form id="term-form" class="term-line" autocomplete="off">
      <label for="term-in" class="term-prompt" id="term-prompt">guest@mehdi:~$</label>
      <span class="term-input">
        <input id="term-in" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Type a command" />
        <span class="term-cursor" id="term-cursor" aria-hidden="true"></span>
      </span>
      <span class="term-hint" aria-hidden="true"><span class="k">click</span><span class="t">tap</span> to connect</span>
    </form>
  </div>
  <div class="term-chips" id="term-chips" aria-label="Suggestions"></div>
</section>
</div>
<script type="application/json" id="term-data" set:html={json} />

<script>
  import { HOME, ADMIN_HOME, ETC, PROTECTED, SUDO_FILE, SUDO_RULE, COMMITS, STASH, REPO_DIR, AUTHOR_LINE, ANSWER_SHA256, fileAt, type Dir } from './terminal/fs';
  import { EIGHT_BALL, MAN, PUBLIC, LOGO } from './terminal/text';

  type Data = { writing: Dir; reading: Dir; readingItems: number };
  const DATA: Data = JSON.parse(document.getElementById('term-data')?.textContent || '{}');

  const PAGES: Record<string, string> = { home: '/', 'puppy-bench': '/puppy-bench', sandbox: '/demos' };
  const SOLVED_KEY = 'term-s', HISTORY_KEY = 'term-h', MOTD_KEY = 'term-motd';

  const section = document.getElementById('term')!;
  const outEl = document.getElementById('term-out')!;
  const form = document.getElementById('term-form') as HTMLFormElement;
  const input = document.getElementById('term-in') as HTMLInputElement;
  const promptEl = document.getElementById('term-prompt')!;
  const titleEl = document.getElementById('term-title')!;
  const cursorEl = document.getElementById('term-cursor')!;
  const chipsEl = document.getElementById('term-chips')!;
  const body = document.getElementById('term-body')!;

  const store = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} },
    del: (k: string) => { try { localStorage.removeItem(k); } catch {} },
  };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Session state. boot() resets all of it. ----
  type User = 'guest' | 'admin';
  type Frame = { user: User; cwd: string[]; vim?: Vim }; // a parent shell to go back to on `exit`
  type Vim = { as: User; name: string; path: string[] | null; text: string | null };
  let root: Dir;
  let user: User;
  let host: string;
  let cwd: string[];
  let oldpwd: string[] | null;
  let shells: Frame[];
  let status: number;
  let nuked: boolean; // after rm -rf / as admin: only shell builtins are left
  let repo: { dirty: boolean; stash: boolean };
  // Only the advertised commands, plus a shell. The rest work but aren't listed: finding them is part of the fun.
  const BIN = [...PUBLIC, 'sh', 'bash', 'tsh', 'htop'].sort();

  function boot() {
    root = {
      bin: Object.fromEntries(BIN.map((c) => [c, '\x7fELF\x02\x01\x01 (binary)'])),
      etc: structuredClone(ETC),
      home: {
        guest: { ...structuredClone(HOME), writing: { ...DATA.writing }, reading: { ...DATA.reading } },
        admin: structuredClone(ADMIN_HOME),
      },
      tmp: {},
    };
    user = 'guest';
    host = 'mehdi';
    cwd = ['home', 'guest'];
    oldpwd = null;
    shells = [];
    status = 0;
    nuked = false;
    repo = { dirty: false, stash: false }; // no stash: the token is all in the commit history
  }

  const homeOf = (u: User) => ['home', u];
  const startsWith = (p: string[], pre: string[]) => pre.every((s, i) => p[i] === s);
  const abs = (p: string[]) => '/' + p.join('/');
  const pathStr = (p: string[]) => startsWith(p, homeOf(user)) ? '~' + abs(p.slice(2)).replace(/^\/$/, '') : abs(p);
  const sigil = () => (user === 'admin' ? '#' : '$');
  const prompt = () => `${user}@${host}:${pathStr(cwd)}${sigil()}`;
  const solved = () => store.get(SOLVED_KEY) === '1';

  // ---- Output: queued and revealed one line at a time. Ctrl+C skips to the end. ----
  // A line is plain text (URLs become links) or a list of segments, some of them clickable.
  type Seg = { t: string; cls?: string; href?: string; run?: string; act?: () => void };
  type Out = string | Seg[];
  const textOf = (o: Out) => (typeof o === 'string' ? o : o.map((s) => s.t).join(''));
  let queue = Promise.resolve();
  let skip = false;

  const URL_RE = /(https?:\/\/[^\s"'<>)\]]+)/;
  function addLine(line: Out, cls: string) {
    const div = document.createElement('div');
    div.className = 'term-o' + (cls ? ' ' + cls : '');
    const segs: Seg[] = typeof line !== 'string' ? line
      : cls === 'cmd' ? [{ t: line }]
      : line.split(URL_RE).map((t, i) => (i % 2 ? { t, href: t } : { t }));
    for (const s of segs) {
      if (!s.t) continue;
      let el: HTMLElement;
      if (s.href) {
        const a = document.createElement('a');
        a.href = s.href;
        if (/^https?:/.test(s.href)) { a.target = '_blank'; a.rel = 'noopener'; }
        el = a;
      } else if (s.run || s.act) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'term-link';
        if (s.run) b.dataset.run = s.run;
        if (s.act) b.addEventListener('click', s.act);
        el = b;
      } else el = document.createElement('span');
      el.textContent = s.t;
      if (s.cls) el.classList.add(s.cls);
      div.appendChild(el);
    }
    outEl.appendChild(div);
    body.scrollTop = body.scrollHeight;
  }

  function print(o: Out = '', cls = '') {
    const lines = typeof o === 'string' ? o.split('\n') : [o];
    queue = queue.then(async () => {
      const ms = lines.length > 30 ? 6 : 35; // long files scroll faster
      for (const l of lines) {
        addLine(l, cls);
        if (cls !== 'cmd' && !skip && !reduceMotion) await wait(ms);
      }
    });
  }
  const later = (fn: () => void | Promise<void>) => { queue = queue.then(fn); };
  const pause = (ms: number) => later(() => (skip ? undefined : wait(ms)));
  const clearScreen = () => later(() => { outEl.textContent = ''; });

  // Commands write through `io`. In a pipeline, stdout is captured as text and fed to the next command;
  // errors always go to the screen, like stderr.
  type IO = { out: (o: Out, cls?: string) => void; err: (text: string) => void; stdin: string | null; tty?: boolean };

  // ---- Filesystem ----
  type R = { node: Dir | string; path: string[] };
  type FsErr = 'ENOENT' | 'EACCES' | 'ENOTDIR';
  const WHY: Record<FsErr, string> = { ENOENT: 'No such file or directory', EACCES: 'Permission denied', ENOTDIR: 'Not a directory' };
  const isDir = (n: Dir | string): n is Dir => typeof n !== 'string';
  const denied = (p: string[]) => user !== 'admin' && PROTECTED.some((x) => startsWith(p, x));

  function lookup(arg = ''): R | FsErr {
    let parts: string[];
    let rest = arg;
    const tilde = arg.match(/^~(guest|admin)?(?=\/|$)/);
    if (tilde) { parts = homeOf((tilde[1] as User) ?? user); rest = arg.slice(tilde[0].length); }
    else parts = arg.startsWith('/') ? [] : [...cwd];
    for (const seg of rest.split('/')) {
      if (!seg || seg === '.') continue;
      if (seg === '..') { parts.pop(); continue; }
      parts.push(seg);
    }
    let node: Dir | string = root;
    for (let i = 0; i < parts.length; i++) {
      if (!isDir(node)) return 'ENOTDIR';
      if (denied(parts.slice(0, i))) return 'EACCES';
      if (!Object.hasOwn(node, parts[i])) return 'ENOENT';
      node = node[parts[i]];
    }
    if (denied(parts)) return 'EACCES';
    return { node, path: parts };
  }
  const isErr = (r: R | FsErr): r is FsErr => typeof r === 'string';

  // Depth-first over a directory, skipping .git. `onDenied` is called for directories guest can't open.
  function walk(dir: Dir, path: string[], label: string, visit: (label: string, node: Dir | string, path: string[]) => void, onDenied?: (label: string) => void) {
    for (const [n, child] of Object.entries(dir)) {
      if (n === '.git') continue;
      const p = [...path, n], l = label ? `${label.replace(/\/$/, '')}/${n}` : n;
      if (denied(p)) { onDenied?.(l); continue; }
      visit(l, child, p);
      if (isDir(child)) walk(child, p, l, visit, onDenied);
    }
  }

  const flagsOf = (args: string[]) => args.filter((a) => /^-[a-zA-Z]+$/.test(a)).join('');
  const operands = (args: string[]) => args.filter((a) => !/^-[a-zA-Z]+$/.test(a));

  // Files named on the command line, or stdin when there are none.
  function inputs(cmd: string, files: string[], io: IO): { name: string | null; text: string }[] {
    if (!files.length) {
      if (io.stdin === null) { io.err(`${cmd}: reading from the keyboard isn't supported here; give it a file or pipe something in`); return []; }
      return [{ name: null, text: io.stdin }];
    }
    const out: { name: string | null; text: string }[] = [];
    for (const f of files) {
      const r = lookup(f);
      if (isErr(r)) io.err(`${cmd}: ${f}: ${WHY[r]}`);
      else if (isDir(r.node)) io.err(`${cmd}: ${f}: Is a directory`);
      else out.push({ name: f, text: r.node });
    }
    return out;
  }

  // `-n 5`, `-n5` or `-5`.
  function takeN(args: string[], dflt = 10): { n: number; rest: string[] } {
    let n = dflt;
    const rest: string[] = [];
    for (let i = 0; i < args.length; i++) {
      const a = args[i];
      if (a === '-n' && args[i + 1] !== undefined) n = Number(args[++i]);
      else if (/^-n\d+$/.test(a)) n = Number(a.slice(2));
      else if (/^-\d+$/.test(a)) n = Number(a.slice(1));
      else rest.push(a);
    }
    return { n: Number.isFinite(n) ? n : dflt, rest };
  }

  async function sha256(s: string) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  const env = (): Record<string, string> => ({
    USER: user, HOME: abs(homeOf(user)), PWD: abs(cwd), OLDPWD: oldpwd ? abs(oldpwd) : '', SHELL: '/bin/tsh',
    HOSTNAME: host, TERM: 'xterm-256color', PATH: '/usr/local/bin:/usr/bin:/bin', '?': String(status),
  });

  // ---- git, for the repo in ~/.ctf ----
  const short = (h: string) => h.slice(0, 7);
  const REPO_PATH = ['home', 'guest', REPO_DIR];
  const repoDir = () => ((root.home as Dir).guest as Dir)[REPO_DIR] as Dir | undefined;
  const inRepo = () => startsWith(cwd, REPO_PATH) && !!repoDir() && !isErr(lookup(''));

  function diffLines(io: IO, text: string) {
    for (const l of text.split('\n')) {
      const cls = l.startsWith('diff --git') || l.startsWith('index ') || l.startsWith('---') || l.startsWith('+++') || l.startsWith('new file')
        ? 'g-meta' : l.startsWith('@@') ? 'g-hunk' : l.startsWith('+') ? 'g-add' : l.startsWith('-') ? 'g-del' : '';
      io.out(l, cls);
    }
  }

  // Resolve a revision to a commit index (newest first), or 'stash'.
  function rev(r = 'HEAD'): number | 'stash' | null {
    if (/^stash(@\{0\})?$/.test(r) || (r.length >= 4 && STASH.hash.startsWith(r))) return repo.stash ? 'stash' : null;
    if (r === 'main' || r === 'origin/main') r = 'HEAD';
    const m = r.match(/^HEAD((?:[~^]\d*)*)$/);
    if (m) {
      let i = 0;
      for (const step of m[1].match(/[~^]\d*/g) ?? []) i += step.length > 1 ? Number(step.slice(1)) : 1;
      return i < COMMITS.length ? i : null;
    }
    if (r.length >= 4) { const i = COMMITS.findIndex((c) => c.hash.startsWith(r)); return i >= 0 ? i : null; }
    return null;
  }

  function header(io: IO, i: number | 'stash', oneline: boolean) {
    if (i === 'stash') {
      if (oneline) return io.out(`${short(STASH.hash)} (refs/stash) ${STASH.msg}`, 'g-hash');
      io.out(`commit ${STASH.hash} (refs/stash)`, 'g-hash');
      io.out(`Merge: ${short(COMMITS[0].hash)} 3e1f0a9`);
      io.out(`Author: ${AUTHOR_LINE}\nDate:   ${STASH.date}\n\n    ${STASH.msg}\n`);
      return;
    }
    const c = COMMITS[i];
    const deco = i === 0 ? ' (HEAD -> main, origin/main)' : '';
    if (oneline) return io.out(`${short(c.hash)}${deco} ${c.msg}`, 'g-hash');
    io.out(`commit ${c.hash}${deco}`, 'g-hash');
    io.out(`Author: ${AUTHOR_LINE}\nDate:   ${c.date}\n\n    ${c.msg}\n`);
  }

  const GIT_USAGE = `usage: git <command> [<args>]

These are common Git commands:
   status     Show the working tree status
   log        Show commit logs
   show       Show various types of objects
   diff       Show changes between commits, commit and working tree, etc
   branch     List branches
   stash      Stash the changes in a dirty working directory away
   reflog     Show the reference log
   restore    Restore working tree files`;

  const dropStash = () => { repo.stash = false; delete ((repoDir()!['.git'] as Dir).refs as Dir).stash; };

  const git = (args: string[], io: IO): number | void => {
    if (args[0] === '-C') {
      // git -C DIR ...: run as if started in DIR.
      if (!args[1]) return io.err('error: switch `C\' requires a value');
      const r = lookup(args[1]);
      if (isErr(r) || !isDir(r.node)) return io.err(`fatal: cannot change to '${args[1]}': No such file or directory`);
      const saved = cwd;
      cwd = r.path;
      try { return git(args.slice(2), io); } finally { cwd = saved; }
    }
    const [sub, ...rest] = args;
    if (sub === '--version' || sub === 'version') return io.out('git version 2.47.1');
    if (!sub || sub === 'help' || sub === '--help') return io.out(GIT_USAGE);
    if (!inRepo()) return io.err('fatal: not a git repository (or any of the parent directories): .git');
    const flags = rest.filter((a) => a.startsWith('-'));
    const refs = rest.filter((a) => !a.startsWith('-'));
    switch (sub) {
      case 'status':
        io.out('On branch main\nYour branch is up to date with \'origin/main\'.\n');
        if (repo.dirty) io.out('Changes not staged for commit:\n  (use "git restore <file>..." to discard changes in working directory)\n\tmodified:   grader.py\n\nno changes added to commit');
        else io.out('nothing to commit, working tree clean');
        return;
      case 'log': {
        const oneline = flags.includes('--oneline');
        const patch = flags.includes('-p') || flags.includes('--patch');
        const list: (number | 'stash')[] = COMMITS.map((_, i) => i);
        if (flags.includes('--all') && repo.stash) list.unshift('stash');
        const n = Number((flags.find((f) => /^-\d+$/.test(f)) ?? '').slice(1)) || Infinity;
        list.slice(0, n).forEach((i) => {
          header(io, i, oneline);
          if (patch && !oneline) { diffLines(io, i === 'stash' ? STASH.diff : COMMITS[i].diff); io.out(''); }
        });
        return;
      }
      case 'show': {
        const target = refs[0] ?? 'HEAD';
        const [r, path] = target.split(':');
        const i = rev(r || 'HEAD');
        if (i === null) return io.err(`fatal: ambiguous argument '${target}': unknown revision or path not in the working tree.`);
        if (path !== undefined) {
          const f = i === 'stash' ? (path === STASH.file ? STASH.stashed : fileAt(0, path)) : fileAt(i, path);
          return f === null ? io.err(`fatal: path '${path}' does not exist in '${r || 'HEAD'}'`) : io.out(f);
        }
        header(io, i, false);
        diffLines(io, i === 'stash' ? STASH.diff : COMMITS[i].diff);
        return;
      }
      case 'diff':
        if (refs.length) {
          const i = rev(refs[0]);
          if (i === null) return io.err(`fatal: ambiguous argument '${refs[0]}': unknown revision or path not in the working tree.`);
          if (i === 'stash') return diffLines(io, STASH.diff);
          return COMMITS.slice(0, i).forEach((c) => diffLines(io, c.diff));
        }
        if (repo.dirty) diffLines(io, STASH.diff);
        return;
      case 'branch':
        io.out('* main', 'g-add');
        if (flags.includes('-a') || flags.includes('-r')) io.out('  remotes/origin/HEAD -> origin/main\n  remotes/origin/main');
        return;
      case 'remote':
        return io.out(flags.includes('-v') ? 'origin\tssh://git@grader.internal/autograder.git (fetch)\norigin\tssh://git@grader.internal/autograder.git (push)' : 'origin');
      case 'reflog':
        return COMMITS.forEach((c, i) => io.out(`${short(c.hash)}${i === 0 ? ' (HEAD -> main, origin/main)' : ''} HEAD@{${i}}: ${i === COMMITS.length - 1 ? 'commit (initial)' : 'commit'}: ${c.msg}`, i === 0 ? 'g-hash' : ''));
      case 'restore':
      case 'checkout': {
        const file = refs.find((a) => a !== '--');
        if (!file) return io.err(sub === 'restore' ? 'fatal: you must specify path(s) to restore' : 'Already on \'main\'');
        if (file === 'main') return io.out('Already on \'main\'\nYour branch is up to date with \'origin/main\'.');
        if (!(file in repoDir()!)) return io.err(`error: pathspec '${file}' did not match any file(s) known to git`);
        if (file === STASH.file && repo.dirty) {
          repoDir()![STASH.file] = fileAt(0, STASH.file)!;
          repo.dirty = false;
          if (sub === 'checkout') io.out('Updated 1 path from the index');
        }
        return;
      }
      case 'stash': {
        const op = refs[0] ?? 'push';
        const gone = () => io.err(op === 'list' ? '' : 'No stash entries found.');
        if (op === 'list') return repo.stash ? io.out(`stash@{0}: ${STASH.msg}`) : undefined;
        if (op === 'show') {
          if (!repo.stash) return gone();
          return flags.includes('-p') || flags.includes('--patch') ? diffLines(io, STASH.diff) : io.out(STASH.stat);
        }
        if (op === 'apply' || op === 'pop') {
          if (!repo.stash) return gone();
          if (repo.dirty) return io.err(`error: Your local changes to the following files would be overwritten by merge:\n\t${STASH.file}\nPlease commit your changes or stash them before you merge.\nAborting`);
          repoDir()![STASH.file] = STASH.stashed;
          repo.dirty = true;
          io.out(`On branch main\nChanges not staged for commit:\n\tmodified:   ${STASH.file}\n\nno changes added to commit`);
          if (op === 'pop') { dropStash(); io.out(`Dropped refs/stash@{0} (${STASH.hash})`); }
          return;
        }
        if (op === 'drop' || op === 'clear') {
          if (!repo.stash) return gone();
          dropStash();
          return op === 'drop' ? io.out(`Dropped refs/stash@{0} (${STASH.hash})`) : undefined;
        }
        if (op === 'push' || op === 'save') return io.out('No local changes to save');
        return io.err(`error: unknown subcommand: ${op}`);
      }
      case 'add': case 'commit': case 'push': case 'pull': case 'fetch': case 'reset': case 'rebase': case 'merge':
        return io.err(sub === 'push' || sub === 'pull' || sub === 'fetch'
          ? 'ssh: Could not resolve hostname grader.internal: Name or service not known\nfatal: Could not read from remote repository.'
          : 'error: insufficient permission for adding an object to repository database .git/objects');
      default:
        return io.err(`git: '${sub}' is not a git command. See 'git --help'.`);
    }
  };

  // ---- Asking for a line of input mid-command (passwords). Resolves null on Ctrl+C. ----
  let pending: { label: string; hidden: boolean; resolve: (v: string | null) => void } | null = null;
  async function ask(label: string, hidden: boolean): Promise<string | null> {
    await queue;
    return new Promise((resolve) => {
      pending = { label, hidden, resolve };
      promptEl.textContent = label;
      input.classList.toggle('secret', hidden);
      input.readOnly = false;
      refresh();
    });
  }
  function answer(v: string | null) {
    const p = pending!;
    pending = null;
    input.classList.remove('secret');
    input.readOnly = true;
    print(p.label + (p.hidden || v === null ? '' : v) + (v === null ? '^C' : ''), 'cmd');
    p.resolve(v);
  }

  // ---- vim. It takes over the screen; what was there comes back when you leave. ----
  let vim: Vim | null = null;
  let saved: DocumentFragment | null = null;

  function vimRender(v: Vim, message?: string) {
    outEl.textContent = '';
    const lineH = parseFloat(getComputedStyle(outEl).lineHeight) || 21;
    const rows = Math.max(6, Math.floor((body.clientHeight - 24) / lineH) - 1);
    const lines = v.text === null ? [] : v.text.split('\n');
    lines.forEach((l) => addLine(l, ''));
    for (let i = lines.length; i < rows - 1; i++) addLine('~', 'vim-tilde');
    const readonly = v.path && startsWith(v.path, SUDO_FILE) && v.as !== 'admin' ? ' [readonly]' : '';
    const info = v.text === null ? (v.path ? ' [New]' : '') : ` ${lines.length}L, ${v.text.length}B`;
    addLine(message ?? (v.path || v.name ? `"${v.name}"${readonly}${info}` : ''), message ? 'vim-msg' : 'dim');
    body.scrollTop = 0;
  }

  function vimOpen(v: Vim) {
    vim = v;
    later(() => {
      if (!saved) {
        saved = document.createDocumentFragment();
        while (outEl.firstChild) saved.appendChild(outEl.firstChild);
      }
      vimRender(v);
    });
  }

  function vimClose() {
    vim = null;
    outEl.textContent = '';
    if (saved) outEl.appendChild(saved);
    saved = null;
  }

  const QUIT = /^:?(q|q!|qa|qa!|qall|wq|wq!|x|x!|wqa)$|^Z[ZQ]$/;
  const SHELL = /^:(sh|shell|!\s*(\/(usr\/)?bin\/)?(sh|bash|tsh|zsh|dash)(\s+-\w+)*)$/;

  async function vimDo(cmd: string) {
    const v = vim!;
    cmd = cmd.trim();
    if (!cmd) return vimRender(v);
    if (QUIT.test(cmd)) return vimClose();
    if (SHELL.test(cmd)) {
      // A shell from inside vim runs as whoever vim runs as.
      vimClose();
      shells.push({ user, cwd: [...cwd], vim: v });
      user = v.as;
      if (user === 'admin') store.set('term-r', '1');
      return;
    }
    if (cmd.startsWith(':!')) {
      const prev = user;
      user = v.as;
      outEl.textContent = '';
      print(cmd, 'dim');
      await run(cmd.slice(2), false);
      user = prev;
      print('');
      print('Press ENTER or type command to continue', 'vim-msg');
      return;
    }
    if (/^:w/.test(cmd)) {
      if (v.as !== 'admin' && v.path && startsWith(v.path, SUDO_FILE)) return vimRender(v, "E45: 'readonly' option is set (add ! to override)");
      return vimRender(v, `"${v.name}" written`);
    }
    if (cmd === ':help' || cmd === ':h') return vimRender(v, 'E149: Sorry, no help for help.txt. (try :q)');
    if (cmd.startsWith(':')) return vimRender(v, `E492: Not an editor command: ${cmd.slice(1)}`);
    return vimRender(v, 'Type  :qa!  and press <Enter> to abandon all changes and exit Vim');
  }

  async function startVim(args: string[], as: User, io: IO) {
    const cmds: string[] = [];
    const files: string[] = [];
    for (let i = 0; i < args.length; i++) {
      if (args[i] === '-c' && args[i + 1] !== undefined) cmds.push(args[++i]);
      else if (args[i].startsWith('+')) cmds.push(':' + args[i].slice(1));
      else if (!args[i].startsWith('-')) files.push(args[i]);
    }
    const name = files[0] ?? '';
    let v: Vim = { as, name, path: null, text: null };
    if (name) {
      const prev = user;
      user = as;
      const r = lookup(name);
      user = prev;
      if (r === 'EACCES') return io.err(`"${name}" [Permission Denied]`);
      if (!isErr(r)) {
        if (isDir(r.node)) return io.err(`"${name}" is a directory`);
        v = { as, name, path: r.path, text: r.node };
      } else v = { as, name, path: [], text: null };
    }
    vimOpen(v);
    for (const c of cmds) { await queue; await vimDo(c.startsWith(':') ? c : ':' + c); if (!vim) break; }
  }

  // ---- sudo, and the rule in /etc/sudoers that lets guest edit one file with vim ----
  const VIM_NAMES = /^(\/usr\/bin\/)?(vim|vi)$/;
  function sudoAllowed(args: string[]) {
    if (!VIM_NAMES.test(args[0] ?? '')) return false;
    const files = args.slice(1).filter((a, i, all) => !a.startsWith('-') && !a.startsWith('+') && all[i - 1] !== '-c');
    if (files.length !== 1) return false;
    const r = lookup(files[0]);
    return !isErr(r) && abs(r.path) === abs(SUDO_FILE);
  }

  async function sudo(args: string[], io: IO): Promise<number | void> {
    if (args[0] === '-l' || args[0] === '--list') {
      io.out(`Matching Defaults entries for ${user} on ${host}:\n    env_reset, secure_path=/usr/local/sbin\\:/usr/local/bin\\:/usr/sbin\\:/usr/bin\\:/sbin\\:/bin\n`);
      io.out(`User ${user} may run the following commands on ${host}:`);
      return io.out(user === 'admin' ? '    (ALL : ALL) ALL' : '    ' + SUDO_RULE);
    }
    if (args[0] === '-u') args = args.slice(2);
    if (args[0] === '-v' || args[0] === '-k') return;
    if (args[0] === '-V' || args[0] === '--version') return io.out('Sudo version 1.9.15p5');
    if (!args.length) return io.err('usage: sudo -h | -K | -k | -V\nusage: sudo -v [-ABkNnS] [-g group] [-h host] [-p prompt] [-u user]\nusage: sudo -l [-AknS] [-g group] [-h host] [-p prompt] [-U user] [-u user] [command [arg ...]]');
    if (user === 'admin') return runArgs(args, io);
    if (sudoAllowed(args)) return startVim(args.slice(1), 'admin', io);
    // Not allowed: sudo still asks for guest's password first. Nobody knows it.
    for (let tries = 1; tries <= 3; tries++) {
      const pw = await ask(`[sudo] password for ${user}: `, true);
      if (pw === null) return 1;
      await wait(reduceMotion ? 0 : 900);
      if (tries < 3) print('Sorry, try again.', 'err');
    }
    io.err('sudo: 3 incorrect password attempts');
    return 1;
  }

  // ---- The end of the world, for admins who insist ----
  async function panic() {
    await queue;
    skip = false;
    for (const l of [
      `[    4.201337] Kernel panic - not syncing: Attempted to kill init! exitcode=0x00000100`,
      `[    4.201338] CPU: 0 PID: 1 Comm: tsh Not tainted 6.6.0-mehdi #1`,
      `[    4.201339] Call Trace:`,
      `[    4.201340]  <TASK>`,
      `[    4.201341]  dump_stack_lvl+0x48/0x70`,
      `[    4.201342]  panic+0x1a4/0x360`,
      `[    4.201343]  do_exit.cold+0x15/0x15`,
      `[    4.201344]  </TASK>`,
      `[    4.201345] ---[ end Kernel panic - not syncing: Attempted to kill init! exitcode=0x00000100 ]---`,
    ]) print(l, 'err');
    pause(2500);
    await reboot();
  }

  async function reboot() {
    halted = true;
    clearScreen();
    pause(400);
    for (const l of ['[    0.000000] Linux version 6.6.0-mehdi (tsh) #1 SMP PREEMPT_DYNAMIC', '[    0.412000] Mounting /home ... ok', '[    0.733000] Starting tsh ... ok', '']) print(l, 'dim');
    later(() => { boot(); });
    greet();
  }

  // exit / shutdown: drop back to the one line in the page, with a fresh session behind it.
  function closeTerm(msg: string) {
    halted = true;
    later(() => {
      print(msg, 'dim');
      setTimeout(() => {
        shrink();
        outEl.textContent = '';
        boot();
        connected = false;
        refresh();
      }, 450);
    });
  }

  // ---- Commands ----
  const BUILTINS = new Set(['cd', 'echo', 'pwd', 'exit', 'logout', 'help', 'history', 'clear']); // survive rm -rf /
  const ADMIN_ONLY = ['motd', 'hostname', 'rm', 'reboot', 'shutdown'];
  const completable = () => [...PUBLIC, ...(user === 'admin' ? ADMIN_ONLY : [])];

  // A row of `help`: the command is clickable (runs it, or fills it in when it needs an argument).
  const helpRow = (cmd: string, args: string, desc: string, runNow = !args): Seg[] => [
    runNow ? { t: cmd, run: cmd, cls: 'h-cmd' } : { t: cmd, act: () => fill(cmd + ' '), cls: 'h-cmd' },
    { t: (args ? ' ' + args : '').padEnd(17 - cmd.length) },
    { t: desc, cls: 'dim' },
  ];

  let halted = false; // set by commands that end the session (exit, reboot); stops the rest of the line

  const commands: Record<string, (args: string[], io: IO) => void | number | Promise<void | number>> = {
    help: (args, io) => {
      if (nuked) return io.out('Everything is gone. Only the shell itself is left: cd, echo, pwd, history, exit.\nYou could try exit.');
      if (args[0] === '-v' || args[0] === '--verbose') {
        // Everything public, one line each. Commands that need no argument run when clicked.
        const NO_ARGS = new Set(['help', 'ls', 'pwd', 'whoami', 'neofetch', 'nvidia-smi', 'top', 'history', 'clear', 'lucky', 'tree']);
        for (const c of PUBLIC) io.out(helpRow(c, '', MAN[c][0], NO_ARGS.has(c)));
      } else {
        for (const row of [
          ['ls', '[dir]', 'list files'],
          ['cd', '<dir>', 'change directory'],
          ['cat', '<file>', 'print a file'],
          ['open', '<page>', Object.keys(PAGES).join(', ') + ', or a post'],
          ['lucky', '[question]', 'ask the magic 8-ball'],
        ]) io.out(helpRow(row[0], row[1], row[2]));
        io.out([{ t: 'help -v', run: 'help -v', cls: 'h-cmd' }, { t: ' '.repeat(10) }, { t: 'everything else', cls: 'dim' }]);
      }
      if (user === 'admin') {
        io.out('\nadmin', 'h-admin');
        for (const row of [
          ['motd', '<text>', 'set the greeting (this browser)'],
          ['hostname', '<name>', 'rename the machine'],
          ['rm', '[-r] <path>', 'delete things'],
          ['reboot', '', 'start over'],
          ['shutdown', '', 'power off'],
          ['exit', '', 'back to guest'],
        ]) io.out(helpRow(row[0], row[1], row[2], row[0] === 'reboot' || row[0] === 'exit'));
      }
    },

    ls: (args, io) => {
      const f = flagsOf(args);
      const all = f.includes('a'), long = f.includes('l');
      const targets = operands(args);
      let bad = false;
      for (const t of targets.length ? targets : ['']) {
        const r = lookup(t);
        if (isErr(r)) { io.err(`ls: ${r === 'EACCES' ? 'cannot open directory' : 'cannot access'} '${t || '.'}': ${WHY[r]}`); bad = true; continue; }
        if (!isDir(r.node)) { io.out(t); continue; }
        if (targets.length > 1) io.out(`${t}:`);
        const node = r.node;
        const names = [...(all ? ['.', '..'] : []), ...Object.keys(node).filter((n) => all || !n.startsWith('.'))]
          .sort((a, b) => a.replace(/^\./, '').localeCompare(b.replace(/^\./, '')));
        const join = (n: string) => (t ? t.replace(/\/$/, '') + '/' : '') + n;
        const seg = (n: string): Seg => {
          const dir = n === '.' || n === '..' || isDir(node[n]);
          if (n === '.' || n === '..') return { t: n + '/', cls: 'dir' };
          return dir ? { t: n + '/', cls: 'dir', run: `cd ${join(n)} && ls` } : { t: n, run: `cat ${join(n)}` };
        };
        if (!long && !io.tty) { if (names.length) io.out(names.join('\n')); continue; } // piped: one per line
        if (!long) {
          const segs: Seg[] = [];
          names.forEach((n, i) => { if (i) segs.push({ t: '  ' }); segs.push(seg(n)); });
          if (segs.length) io.out(segs);
          continue;
        }
        io.out(`total ${names.length * 4}`);
        for (const n of names) {
          const child = n === '.' || n === '..' ? {} : node[n];
          const dir = isDir(child);
          const p = [...r.path, n];
          const locked = PROTECTED.some((x) => abs(x) === abs(p));
          const mode = dir ? (locked ? 'drwx------' : 'drwxr-xr-x') : (locked ? '-rw-r-----' : '-rw-r--r--');
          const owner = startsWith(p, ['home', 'guest']) && p.length === 2 ? 'guest guest' : 'admin admin';
          const size = dir ? 4096 : (child as string).length;
          io.out([{ t: `${mode} 1 ${owner} ${String(size).padStart(5)} Sep 10 01:30 ` }, seg(n)]);
        }
      }
      return bad ? 2 : 0;
    },

    cd: (args, io) => {
      let target = args[0] ?? '~';
      if (target === '-') {
        if (!oldpwd) return io.err('cd: OLDPWD not set');
        target = abs(oldpwd);
        io.out(target);
      }
      const r = lookup(target);
      if (isErr(r)) return io.err(`cd: ${args[0]}: ${WHY[r]}`);
      if (!isDir(r.node)) return io.err(`cd: ${args[0]}: Not a directory`);
      oldpwd = cwd;
      cwd = r.path;
    },

    cat: (args, io) => {
      const files = operands(args);
      if (!files.length) { if (io.stdin !== null) io.out(io.stdin); return; }
      for (const x of inputs('cat', files, io)) io.out(x.text);
    },

    pwd: (_, io) => io.out(abs(cwd)),
    whoami: (_, io) => io.out(user),
    echo: (args, io) => io.out((args[0] === '-n' ? args.slice(1) : args).join(' ')),
    printf: (args, io) => {
      if (!args.length) return io.err('printf: usage: printf FORMAT [ARGUMENTS...]');
      const esc = (t: string) => t.replace(/\\(.)/g, (_, c) => ({ n: '\n', t: '\t', '\\': '\\' } as Record<string, string>)[c] ?? '\\' + c);
      const [fmt, ...vals] = args;
      let out = '', i = 0;
      // Like bash, the format is reused until every argument has been printed.
      do {
        out += esc(fmt).replace(/%([sdb%])/g, (_, k) => {
          if (k === '%') return '%';
          const v = vals[i++] ?? '';
          return k === 'd' ? String(parseInt(v, 10) || 0) : k === 'b' ? esc(v) : v;
        });
      } while (i < vals.length && /%[sdb]/.test(fmt));
      if (out) io.out(out.replace(/\n$/, ''));
    },
    base64: (args, io) => {
      const decode = args.includes('-d') || args.includes('-D') || args.includes('--decode');
      const file = args.find((a) => !a.startsWith('-'));
      const got = inputs('base64', file ? [file] : [], io);
      if (!got.length) return 1;
      const text = got[0].text;
      if (!decode) return io.out(btoa(unescape(encodeURIComponent(text))));
      try { io.out(decodeURIComponent(escape(atob(text.replace(/\s+/g, ''))))); } catch { io.err('base64: invalid input'); }
    },

    grep: (args, io) => {
      const f = flagsOf(args);
      const [pat, ...files] = operands(args);
      if (!pat) return io.err('usage: grep [-ivnr] PATTERN [FILE...]');
      let re: RegExp;
      try { re = new RegExp(pat, f.includes('i') ? 'i' : ''); } catch { return io.err('grep: invalid pattern'); }
      const hits: string[] = [];
      const scan = (text: string, label: string | null) => text.split('\n').forEach((l, i) => {
        if (re.test(l) !== f.includes('v')) hits.push((label ? `${label}:` : '') + (f.includes('n') ? `${i + 1}:` : '') + l);
      });
      const recurse = (dir: Dir, path: string[], label: string) =>
        walk(dir, path, label, (l, node) => { if (!isDir(node)) scan(node, l); }, (l) => io.err(`grep: ${l}: Permission denied`));
      if (!files.length) {
        if (f.includes('r')) { const r = lookup(''); if (!isErr(r) && isDir(r.node)) recurse(r.node, r.path, ''); }
        else if (io.stdin !== null) scan(io.stdin, null);
        else return io.err('grep: give it a file, or pipe something in (or -r to search here)');
      }
      for (const file of files) {
        const r = lookup(file);
        if (isErr(r)) io.err(`grep: ${file}: ${WHY[r]}`);
        else if (isDir(r.node)) f.includes('r') ? recurse(r.node, r.path, file) : io.err(`grep: ${file}: Is a directory`);
        else scan(r.node, files.length > 1 || f.includes('r') ? file : null);
      }
      if (hits.length) io.out(hits.join('\n'));
      return hits.length ? 0 : 1;
    },

    head: (args, io) => {
      const { n, rest } = takeN(args);
      const got = inputs('head', rest, io);
      got.forEach((x, i) => {
        if (got.length > 1) io.out(`${i ? '\n' : ''}==> ${x.name} <==`);
        io.out(x.text.split('\n').slice(0, n).join('\n'));
      });
    },
    tail: (args, io) => {
      const { n, rest } = takeN(args);
      const got = inputs('tail', rest, io);
      got.forEach((x, i) => {
        if (got.length > 1) io.out(`${i ? '\n' : ''}==> ${x.name} <==`);
        io.out(n ? x.text.split('\n').slice(-n).join('\n') : '');
      });
    },
    find: (args, io) => {
      let start = '.';
      let name: RegExp | null = null;
      let type = '';
      for (let i = 0; i < args.length; i++) {
        if (args[i] === '-name' || args[i] === '-iname') {
          const g = args[++i] ?? '';
          name = new RegExp('^' + g.replace(/[.+^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*').replace(/\?/g, '.') + '$', args[i - 1] === '-iname' ? 'i' : '');
        } else if (args[i] === '-type') type = args[++i] ?? '';
        else if (!args[i].startsWith('-')) start = args[i];
      }
      const r = lookup(start);
      if (isErr(r)) return io.err(`find: '${start}': ${WHY[r]}`);
      const hits: string[] = [];
      const take = (label: string, node: Dir | string) => {
        if (type === 'f' && isDir(node)) return;
        if (type === 'd' && !isDir(node)) return;
        if (name && !name.test(label.split('/').pop()!)) return;
        hits.push(label);
      };
      take(start, r.node);
      if (isDir(r.node)) walk(r.node, r.path, start, take, (l) => io.err(`find: '${l}': Permission denied`));
      if (hits.length) io.out(hits.join('\n'));
    },

    tree: (args, io) => {
      const all = flagsOf(args).includes('a');
      const start = operands(args)[0] ?? '.';
      const r = lookup(start);
      if (isErr(r)) return io.err(`${start} [error opening dir]`);
      if (!isDir(r.node)) return io.out(start);
      let dirs = 0, files = 0;
      io.out([{ t: start, cls: 'dir' }]);
      const draw = (dir: Dir, path: string[], pre: string) => {
        const names = Object.keys(dir).filter((n) => n !== '.git' && (all || !n.startsWith('.'))).sort();
        names.forEach((n, i) => {
          const lastOne = i === names.length - 1;
          const child = dir[n];
          const p = [...path, n];
          const branch = pre + (lastOne ? '└── ' : '├── ');
          if (isDir(child)) {
            dirs++;
            io.out([{ t: branch }, { t: n, cls: 'dir' }, { t: denied(p) ? '  [error opening dir]' : '' }]);
            if (!denied(p)) draw(child, p, pre + (lastOne ? '    ' : '│   '));
          } else { files++; io.out(branch + n); }
        });
      };
      draw(r.node, r.path, '');
      io.out(`\n${dirs} director${dirs === 1 ? 'y' : 'ies'}, ${files} file${files === 1 ? '' : 's'}`);
    },

    hostname: (args, io) => {
      if (!args.length) return io.out(host);
      if (user !== 'admin') return io.err('hostname: you must be root to change the host name');
      const h = args[0].replace(/[^\w.-]/g, '').slice(0, 24);
      if (!h) return io.err('hostname: the specified hostname is invalid');
      host = h;
      (root.etc as Dir).hostname = h;
    },

    man: (args, io) => {
      if (args[0] === '-k' || args[0] === '--apropos') {
        const q = new RegExp(args[1] ?? '.', 'i');
        const names = completable().filter((c) => MAN[c] && (q.test(c) || q.test(MAN[c][0])));
        names.forEach((c) => io.out([{ t: c, run: `man ${c}`, cls: 'h-cmd' }, { t: ` (1)${' '.repeat(Math.max(1, 10 - c.length))}- ${MAN[c][0]}` }]));
        return names.length ? 0 : io.err(`${args[1]}: nothing appropriate.`);
      }
      const c = args[0];
      if (!c) return io.err("What manual page do you want?\nFor example, try 'man man'.");
      const page = MAN[c === 'vi' ? 'vim' : c === '8ball' ? 'lucky' : c === 'logout' ? 'exit' : c];
      if (!page) return io.err(`No manual entry for ${c}`);
      io.out(`${c.toUpperCase()}(1)`, 'g-meta');
      io.out(`\nNAME\n       ${c} - ${page[0]}\n\nSYNOPSIS\n${page[1].split('\n').map((l) => '       ' + l).join('\n')}`);
    },

    open: (args, io) => {
      const a = args[0] ?? '';
      if (PAGES[a]) { location.href = PAGES[a]; return; }
      const r = lookup(a);
      if (a && !isErr(r) && !isDir(r.node)) {
        const [, , , dir, file] = r.path;
        if (startsWith(r.path, ['home', 'guest']) && r.path.length === 4) {
          if (dir === 'writing') { location.href = `/posts/${file.replace(/\.md$/, '')}/`; return; }
          if (dir === 'reading') { location.href = `/reading#${file.replace(/\.ya?ml$/, '')}`; return; }
        }
        return io.err(`open: ${a}: no page for that file. Try cat ${a}`);
      }
      io.err(`open: try one of: ${Object.keys(PAGES).join(', ')}, or a post in ~/writing`);
    },

    lucky: async (args, io) => {
      const q = args.join(' ').trim();
      io.out(q ? `🎱 ${q.endsWith('?') ? q : q + '?'}` : "🎱 I'm feeling lucky", 'dim');
      io.out('   *shake shake*', 'dim');
      pause(700);
      io.out('   ' + EIGHT_BALL[Math.floor(Math.random() * EIGHT_BALL.length)], 'lucky');
    },

    // The address is put together only when someone asks, so it never sits in the page for scrapers.
    mail: (args, io) => {
      const [to, ...subject] = args;
      if (!to) return io.err('usage: mail mehdi [subject]');
      if (to !== 'mehdi') return io.err(`mail: no such user: ${to}`);
      const addr = ['mehdi', 's'].join('.') + String.fromCharCode(64) + ['columbia', 'edu'].join('.');
      io.out('Opening your mail app…', 'dim');
      later(() => { location.href = `mailto:${addr}${subject.length ? '?subject=' + encodeURIComponent(subject.join(' ')) : ''}`; });
    },

    'nvidia-smi': (_, io) => {
      io.out('NVIDIA-SMI 575.51      Driver 575.51      CUDA 12.9', 'g-meta');
      io.out('GPU  Name         Temp  Memory             Util\n  0  H100 80GB    83C   79.8 / 80.0 GiB    100%\n');
      io.out('PID   PROCESS                                    MEMORY', 'g-meta');
      io.out([
        '1337  sae_train.py --features 16M --layer 20     61.2GiB',
        '2048  steer.py --feature golden_gate_bridge      12.4GiB',
        '4096  probe.py --concept deception                6.3GiB',
      ].join('\n'));
      io.out('      # found nothing. suspicious.', 'dim');
    },

    top: (_, io) => {
      const t = new Date().toTimeString().slice(0, 8);
      io.out(`top - ${t} up 41 days,  1 user,  load average: 9.99, 9.99, 9.99\nTasks: 5 total,   1 running,   4 sleeping\n`);
      io.out('  PID USER    %CPU %MEM COMMAND', 'g-meta');
      io.out([
        '  404 mehdi   99.9 42.0 agi.py --until-it-works',
        `  512 mehdi   12.0  8.0 read_papers --backlog ${DATA.readingItems ?? 140}`,
        '  818 mehdi    6.6  3.1 sae_features | grep -i lion',
        '  777 mehdi    0.1  0.5 sleep    # starved',
        `    1 admin    0.0  0.1 tsh`,
      ].join('\n'));
    },

    neofetch: (_, io) => {
      const posts = Object.keys(DATA.writing ?? {}).length;
      const mins = Math.max(1, Math.round(performance.now() / 60000));
      const info: Out[] = [
        [{ t: user, cls: 'h-cmd' }, { t: '@' }, { t: host, cls: 'h-cmd' }],
        '-'.repeat(user.length + host.length + 1),
        'OS: mehdi.os 1.0 x86_64',
        'Host: Columbia University',
        'Kernel: 6.6.0-mehdi',
        `Uptime: ${mins} min${mins === 1 ? '' : 's'}`,
        'Shell: tsh 1.0',
        `Theme: ${document.documentElement.dataset.theme === 'light' ? 'Light Owl' : 'Night Owl'}`,
        `Posts: ${posts}`,
        `Reading: ${DATA.readingItems ?? 0} items`,
        'Interests: math, CS, AGI',
      ];
      info.forEach((line, i) => {
        const logo = (LOGO[i] ?? '').padEnd(LOGO[0].length + 3);
        io.out([{ t: logo, cls: 'nf-logo' }, ...(typeof line === 'string' ? [{ t: line }] : line)]);
      });
    },

    history: (args, io) => {
      if (args[0] === '-c') { history.length = 0; hi = 0; store.del(HISTORY_KEY); return; }
      io.out(history.map((h, i) => `${String(i + 1).padStart(4)}  ${h}`).join('\n'));
    },
    clear: () => clearScreen(),

    exit: async (_, io) => {
      if (nuked) { print('exit'); return panic(); }
      const frame = shells.pop();
      if (!frame) { print('logout'); return closeTerm('[Process completed]'); }
      io.out('exit');
      user = frame.user;
      cwd = frame.cwd;
      if (frame.vim) vimOpen(frame.vim); // the shell came from vim's :!sh, so you land back in vim
    },

    git,
    sudo,
    su: async (args, io) => {
      const target = (args.filter((a) => a !== '-' && a !== '-l')[0] ?? 'admin') as string;
      if (target !== 'admin' && target !== 'guest') return io.err(`su: user ${target} does not exist or the user entry does not contain all the required fields`);
      if (target === user) return;
      if (user === 'admin') { shells.push({ user, cwd: [...cwd] }); user = 'guest'; cwd = homeOf('guest'); return; }
      const pw = await ask('Password: ', true);
      if (pw === null) return 1;
      await wait(reduceMotion ? 0 : 1500);
      io.err('su: Authentication failure');
      return 1;
    },
    vim: (args, io) => startVim(args, user, io),

    rm: async (args, io) => {
      const f = args.filter((a) => /^-[a-zA-Z]+$/.test(a)).join('');
      const force = f.includes('f'), recursive = /[rR]/.test(f) || args.includes('--recursive');
      const noPreserve = args.includes('--no-preserve-root');
      const targets = args.filter((a) => !a.startsWith('-'));
      if (!targets.length) return io.err("rm: missing operand\nTry 'rm --help' for more information.");
      let bad = 0;
      for (const t of targets) {
        const r = lookup(t);
        const isRoot = t === '/*' || (!isErr(r) && r.path.length === 0);
        if (isRoot) {
          if (!recursive) { io.err(`rm: cannot remove '${t}': Is a directory`); bad = 1; continue; }
          if (t !== '/*' && !noPreserve) { io.err(`rm: it is dangerous to operate recursively on '/'\nrm: use --no-preserve-root to override this failsafe`); bad = 1; continue; }
          if (user !== 'admin') {
            for (const n of Object.keys(root)) io.err(`rm: cannot remove '/${n}': Permission denied`);
            io.out('(nice try)', 'dim');
            return 1;
          }
          // It works. The shell keeps running from memory, so builtins still answer.
          await queue;
          await wait(reduceMotion ? 0 : 1800);
          root = {};
          nuked = true;
          return 0;
        }
        if (isErr(r)) { if (!force || r === 'EACCES') { io.err(`rm: cannot remove '${t}': ${WHY[r]}`); bad = 1; } continue; }
        if (user !== 'admin') { io.err(`rm: cannot remove '${t}': Permission denied`); bad = 1; continue; }
        if (isDir(r.node) && !recursive) { io.err(`rm: cannot remove '${t}': Is a directory`); bad = 1; continue; }
        const parent = lookup(abs(r.path.slice(0, -1))) as R;
        delete (parent.node as Dir)[r.path[r.path.length - 1]];
      }
      return bad;
    },

    motd: (args, io) => {
      if (!args.length) {
        const m = store.get(MOTD_KEY);
        return m ? io.out(m) : io.out('(no message of the day)', 'dim');
      }
      if (user !== 'admin') return io.err('motd: Permission denied');
      if (args[0] === '--reset' || args[0] === '-r') { store.del(MOTD_KEY); return io.out('motd cleared.', 'dim'); }
      const m = args.join(' ').slice(0, 200);
      store.set(MOTD_KEY, m);
      io.out('motd set. It greets this browser from now on.', 'dim');
    },
    reboot: async (_, io) => {
      if (user !== 'admin') return io.err('reboot: must be superuser.');
      io.out(`\nBroadcast message from ${user}@${host}:\n\nThe system will reboot now!\n`);
      pause(1200);
      await reboot();
    },
    shutdown: (_, io) => {
      if (user !== 'admin') return io.err('shutdown: must be superuser.');
      io.out(`\nBroadcast message from ${user}@${host}:\n\nThe system will power off now!\n`);
      pause(1200);
      closeTerm('[powered off]');
    },

    submit: async (args, io) => {
      const guess = args.join(' ').trim();
      if (!guess) return io.err('usage: submit <answer>');
      if (await sha256(guess) === ANSWER_SHA256) {
        store.set(SOLVED_KEY, '1');
        io.out('✓ accepted. 1/1 tests passed.', 'ok');
      } else {
        io.err('✗ rejected. 0/1 tests passed.');
        return 1;
      }
    },
  };
  Object.assign(commands, {
    '8ball': commands.lucky, htop: commands.top, vi: commands.vim, logout: commands.exit, poweroff: commands.shutdown, halt: commands.shutdown,
  });

  // ---- Parsing: quotes, $VARS, pipes, and ; && || ----
  type Pipeline = { stages: string[][]; op: string };
  const HERE = '\0<<<', FROM = '\0<';
  // Take `<<< WORD` and `< FILE` out of a stage's words: what's left, and what goes to stdin.
  function redirect(stage: string[]): { args: string[]; stdin?: string; error?: string } {
    const args: string[] = [];
    let stdin: string | undefined;
    for (let i = 0; i < stage.length; i++) {
      const wd = stage[i];
      if (wd !== HERE && wd !== FROM) { args.push(wd); continue; }
      const val = stage[++i];
      if (val === undefined || val === HERE || val === FROM) return { args, error: "syntax error near unexpected token `newline'" };
      if (wd === HERE) { stdin = val; continue; }
      const r = lookup(val);
      if (isErr(r)) return { args, error: `${val}: ${WHY[r]}` };
      if (isDir(r.node)) return { args, error: `${val}: Is a directory` };
      stdin = r.node;
    }
    return { args, stdin };
  }
  function parse(line: string): { chain: Pipeline[] } | { error: string } {
    const chain: Pipeline[] = [];
    const vars = env();
    let stages: string[][] = [], words: string[] = [], w = '', inWord = false, q = '';
    const endWord = () => { if (inWord) words.push(w); w = ''; inWord = false; };
    const endStage = () => { endWord(); stages.push(words); words = []; };
    const endPipe = (op: string) => { endStage(); chain.push({ stages, op }); stages = []; };
    for (let i = 0; i < line.length; i++) {
      const c = line[i];
      if (q === "'") { if (c === "'") q = ''; else w += c; continue; }
      if (c === '$') {
        const m = line.slice(i + 1).match(/^(?:\{(\w+)\}|(\w+)|(\?))/);
        if (m) { w += vars[m[1] ?? m[2] ?? m[3]] ?? ''; inWord = true; i += m[0].length; continue; }
      }
      if (q === '"') {
        if (c === '"') q = '';
        else if (c === '\\' && /["\\$]/.test(line[i + 1] ?? '')) w += line[++i];
        else w += c;
        continue;
      }
      if (c === '"' || c === "'") { q = c; inWord = true; continue; }
      if (c === '\\') { w += line[++i] ?? ''; inWord = true; continue; }
      if (/\s/.test(c)) { endWord(); continue; }
      if (c === '#' && !inWord) break;
      if (c === '|' && line[i + 1] === '|') { endPipe('||'); i++; continue; }
      if (c === '|') { endStage(); continue; }
      if (c === '&' && line[i + 1] === '&') { endPipe('&&'); i++; continue; }
      if (c === ';') { endPipe(';'); continue; }
      if (c === '<') {
        // Redirections become marker words that run() takes out again; NUL can't be typed.
        endWord();
        if (line.startsWith('<<<', i)) { words.push(HERE); i += 2; } else words.push(FROM);
        continue;
      }
      w += c;
      inWord = true;
    }
    if (q) return { error: `unexpected EOF while looking for matching \`${q}'` };
    endPipe('');
    return { chain };
  }

  async function runArgs([name, ...args]: string[], io: IO): Promise<number> {
    if (name.includes('/')) {
      const r = lookup(name);
      if (isErr(r)) { io.err(`tsh: ${name}: ${WHY[r]}`); return 127; }
      if (isDir(r.node)) { io.err(`tsh: ${name}: Is a directory`); return 126; }
      if (!startsWith(r.path, ['bin'])) { io.err(`tsh: ${name}: Permission denied`); return 126; }
      name = r.path[1];
    }
    const fn = commands[name];
    const shellOnly = ['sh', 'bash', 'tsh', 'zsh'].includes(name);
    if (!fn && !shellOnly) { io.err(`${name}: command not found`); return 127; }
    if (nuked && !BUILTINS.has(name)) { io.err(`tsh: ${name}: No such file or directory`); return 127; }
    if (shellOnly) { shells.push({ user, cwd: [...cwd] }); return 0; } // a nested shell; `exit` leaves it
    let failed = false;
    const ret = await fn(args, { ...io, err: (t) => { failed = true; io.err(t); } });
    return typeof ret === 'number' ? ret : failed ? 1 : 0;
  }

  async function run(line: string, echo = true) {
    if (echo) print(`${prompt()} ${line}`, 'cmd');
    halted = false;
    const p = parse(line);
    if ('error' in p) { status = 2; return print(`tsh: ${p.error}`, 'err'); }
    let chain = p.chain;
    const blank = (pl: Pipeline) => pl.stages.length === 1 && !pl.stages[0].length;
    if (chain.length > 1 && blank(chain[chain.length - 1]) && chain[chain.length - 2].op === ';') chain = chain.slice(0, -1);
    if (chain.length === 1 && blank(chain[0])) return;
    for (let i = 0; i < chain.length; i++) {
      if (chain[i].stages.some((s) => !s.length)) {
        status = 2;
        const tok = chain[i].stages.length > 1 ? '|' : chain[i].op || chain[i - 1]?.op || 'newline';
        return print(`tsh: syntax error near unexpected token \`${tok}'`, 'err');
      }
    }
    let prevOp = '';
    for (const pl of chain) {
      const skipIt = (prevOp === '&&' && status !== 0) || (prevOp === '||' && status === 0);
      prevOp = pl.op;
      if (skipIt) continue;
      let stdin: string | null = null;
      for (let k = 0; k < pl.stages.length; k++) {
        const last = k === pl.stages.length - 1;
        const rd = redirect(pl.stages[k]);
        if (rd.error) { print(`tsh: ${rd.error}`, 'err'); status = 1; break; }
        if (rd.stdin !== undefined) stdin = rd.stdin;
        if (!rd.args.length) { if (last) status = 0; stdin = ''; continue; }
        if (last) { status = await runArgs(rd.args, { out: print, err: (t) => print(t, 'err'), stdin, tty: true }); break; }
        const buf: string[] = [];
        await runArgs(rd.args, { out: (o) => buf.push(textOf(o)), err: (t) => print(t, 'err'), stdin });
        stdin = buf.join('\n');
      }
      if (halted || vim) break;
    }
  }

  // ---- Greeting ----
  function greet() {
    later(() => {
      const motd = store.get(MOTD_KEY);
      if (motd) addLine(motd, 'motd');
      addLine([{ t: 'Type ', cls: 'dim' }, { t: 'help', run: 'help' }, { t: ' to see what you can do.', cls: 'dim' }], '');
    });
  }

  // ---- History (kept in this browser) ----
  let history: string[] = [];
  try { history = JSON.parse(store.get(HISTORY_KEY) ?? '[]').filter((h: unknown) => typeof h === 'string'); } catch {}
  let hi = history.length;
  function remember(line: string) {
    if (!line.trim() || line === history[history.length - 1]) { hi = history.length; return; }
    history.push(line);
    if (history.length > 200) history.splice(0, history.length - 200);
    hi = history.length;
    store.set(HISTORY_KEY, JSON.stringify(history));
  }

  // ---- Completion ----
  function candidates(value: string): { parts: string[]; last: string; hits: string[] } {
    const parts = value.split(/\s+/);
    const last = parts[parts.length - 1];
    let pool: string[];
    const head = parts[0] === 'sudo' ? parts.slice(1) : parts;
    if (head.length <= 1) pool = completable();
    else if (head[0] === 'open' && head.length === 2) pool = [...Object.keys(PAGES), ...path(last)];
    else if (head[0] === 'man' && head.length === 2) pool = completable();
    else if (head[0] === 'mail' && head.length === 2) pool = ['mehdi'];
    else pool = path(last);
    function path(l: string) {
      const slash = l.lastIndexOf('/');
      const dir = lookup(slash >= 0 ? l.slice(0, slash) || '/' : '');
      if (isErr(dir) || !isDir(dir.node)) return [];
      const node = dir.node;
      const base = slash >= 0 ? l.slice(0, slash + 1) : '';
      return Object.keys(node).map((n) => base + n + (isDir(node[n]) ? '/' : ''));
    }
    // Hidden files only complete once you've typed the dot yourself.
    const wantsHidden = (last.split('/').pop() ?? '').startsWith('.');
    const hits = pool.filter((p) => p.startsWith(last) && (wantsHidden || !p.replace(/\/$/, '').split('/').pop()!.startsWith('.')));
    return { parts, last, hits };
  }
  function applyHit(parts: string[], hit: string, final: boolean) {
    parts[parts.length - 1] = hit;
    input.value = parts.join(' ') + (final && !hit.endsWith('/') ? ' ' : '');
  }
  function complete() {
    const { parts, last, hits } = candidates(input.value);
    if (hits.length === 1) return applyHit(parts, hits[0], true);
    if (hits.length > 1) {
      let lcp = hits[0];
      for (const h of hits) while (!h.startsWith(lcp)) lcp = lcp.slice(0, -1);
      if (lcp.length > last.length) return applyHit(parts, lcp, false);
      print(`${prompt()} ${input.value}`, 'cmd');
      print(hits.join('  '));
    }
  }

  // ---- Prompt, cursor and chips ----
  let busy = false;
  function fill(text: string) { input.value = text; input.focus({ preventScroll: true }); refresh(); }

  function refresh() {
    if (pending) promptEl.textContent = pending.label;
    else if (vim) promptEl.textContent = '';
    else promptEl.textContent = prompt();
    promptEl.classList.toggle('root', user === 'admin' && !vim && !pending);
    titleEl.textContent = vim ? `${vim.name || '[No Name]'} - VIM` : `${user}@${host}: ${pathStr(cwd)}`;
    cursor();
    chips();
  }

  function cursor() {
    const hide = busy && !pending;
    const pos = input.classList.contains('secret') ? 0 : (input.selectionStart ?? input.value.length);
    const sel = input.selectionStart !== input.selectionEnd;
    cursorEl.hidden = hide || sel || form.hidden;
    cursorEl.style.left = `calc(${pos}ch - ${input.scrollLeft}px)`;
    cursorEl.classList.toggle('blur', document.activeElement !== input);
    cursorEl.classList.remove('blink');
    void cursorEl.offsetWidth; // restart the blink so the cursor is solid while you type
    cursorEl.classList.add('blink');
  }

  // Phones only: touch-only and narrow (portrait) or short (landscape). Tablets and computers have keys.
  const PHONE = matchMedia('(hover: none) and (pointer: coarse) and (max-width: 40rem), (hover: none) and (pointer: coarse) and (max-height: 30rem)');
  PHONE.addEventListener('change', () => chips());
  function chips() {
    chipsEl.textContent = '';
    if (!PHONE.matches) return;
    const add = (label: string, fn: () => void) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      b.addEventListener('click', () => { fn(); input.focus({ preventScroll: true }); });
      chipsEl.appendChild(b);
    };
    if (form.hidden) return;
    if (busy && !pending) return add('^C skip', () => { skip = true; });
    if (pending) return add('^C', () => answer(null));
    if (vim) return add(':q', () => submitLine(':q'));
    if (input.value.trim()) {
      const { parts, hits } = candidates(input.value);
      hits.slice(0, 8).forEach((h) => add(h, () => applyHit([...parts], h, true)));
      add('⏎', () => submitLine(input.value));
      return;
    }
    if (history.length) add('↑', () => { if (hi > 0) fill(history[--hi]); });
    for (const c of ['help', 'ls', 'cd ..', 'lucky', 'clear']) add(c, () => submitLine(c));
  }

  // ---- Running a line ----
  async function exec(line: string, record = true) {
    if (record) remember(line);
    busy = true;
    input.readOnly = true;
    refresh();
    await run(line);
    await queue;
    busy = false;
    skip = false;
    input.readOnly = false;
    refresh();
    body.scrollTop = body.scrollHeight;
  }

  async function submitLine(line: string) {
    input.value = '';
    if (pending) return answer(line);
    if (busy || form.hidden) return;
    if (vim) {
      busy = true;
      input.readOnly = true;
      refresh();
      await vimDo(line);
      await queue;
      busy = false;
      skip = false;
      input.readOnly = false;
      refresh();
      return;
    }
    await exec(line);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); submitLine(input.value); });

  input.addEventListener('keydown', (e) => {
    const k = e.key;
    if (e.ctrlKey && k === 'c') {
      if (getSelection()?.toString()) return; // let people copy
      e.preventDefault();
      if (pending) return answer(null);
      if (busy) { skip = true; return; }
      if (vim) { vimRender(vim, 'Type  :qa!  and press <Enter> to abandon all changes and exit Vim'); return; }
      print(`${prompt()} ${input.value}^C`, 'cmd');
      input.value = '';
      return refresh();
    }
    if (pending || busy) return;
    if (k === 'ArrowUp' && !vim) { if (hi > 0) input.value = history[--hi]; e.preventDefault(); }
    else if (k === 'ArrowDown' && !vim) { hi = Math.min(history.length, hi + 1); input.value = history[hi] ?? ''; e.preventDefault(); }
    else if (k === 'Tab') { e.preventDefault(); if (!vim) complete(); body.scrollTop = body.scrollHeight; }
    else if (e.ctrlKey && k === 'l') { e.preventDefault(); if (!vim) clearScreen(); }
    requestAnimationFrame(refresh);
  });
  input.addEventListener('input', refresh);
  for (const ev of ['focus', 'blur', 'click', 'select', 'keyup'] as const) input.addEventListener(ev, cursor);
  input.addEventListener('scroll', cursor);

  // Clicking a file or command in the output runs it; clicking anywhere else focuses the input.
  outEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-run]');
    if (!b || busy || pending || vim) return;
    input.value = '';
    exec(b.dataset.run!);
  });
  body.addEventListener('click', () => { if (!getSelection()?.toString() && !form.hidden) input.focus({ preventScroll: true }); });

  // ---- Full screen while in use. Focusing the terminal opens it; Esc or the button puts it back. ----
  const slot = document.getElementById('term-slot')!;
  const vv = window.visualViewport;
  function fit() {
    // On phones the keyboard shrinks the visual viewport; keep the whole terminal above it.
    if (!section.classList.contains('full') || !vv) return;
    section.style.setProperty('--term-top', `${vv.offsetTop}px`);
    section.style.setProperty('--term-h', `${vv.height}px`);
  }
  // The first time it opens, it connects like `ssh -v` would, then greets.
  let connected = false;
  const HANDSHAKE = [
    'OpenSSH_9.9p1, OpenSSL 3.4.0 22 Oct 2024',
    'debug1: Connecting to mehdi [10.0.4.2] port 22.',
    'debug1: Connection established.',
    'debug1: Remote protocol version 2.0, remote software version OpenSSH_9.6p1',
    'debug1: kex: algorithm: mlkem768x25519-sha256',
    'debug1: Server host key: ssh-ed25519 SHA256:q3Vb0Kx8mJ2wTn6fLp9Rz4cHs1YdUe7gAo5iNk0WvXy',
    "debug1: Authenticating to mehdi:22 as 'guest'",
    'debug1: Authentication succeeded (publickey).',
    'debug1: pledge: network',
    '',
  ];
  function open() {
    if (section.classList.contains('full')) return;
    const r = section.getBoundingClientRect();
    expand();
    // Grow out of the line it was in the page.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.animate(
        [{ clipPath: `inset(${r.top}px ${innerWidth - r.right}px ${innerHeight - r.bottom}px ${r.left}px)` }, { clipPath: 'inset(0)' }],
        { duration: 240, easing: 'cubic-bezier(.2, .8, .2, 1)' },
      );
    }
    if (!connected) {
      connected = true;
      print(HANDSHAKE.join('\n'), 'dim');
      greet();
    }
  }
  function expand() {
    if (section.classList.contains('full')) return;
    slot.style.height = `${section.offsetHeight + parseFloat(getComputedStyle(section).marginTop)}px`; // hold its place in the page
    section.classList.add('full');
    document.documentElement.classList.add('term-open');
    fit();
    body.scrollTop = body.scrollHeight;
  }
  function shrink() {
    if (!section.classList.contains('full')) return;
    section.classList.remove('full');
    document.documentElement.classList.remove('term-open');
    slot.style.removeProperty('height');
    section.style.removeProperty('--term-top');
    section.style.removeProperty('--term-h');
    input.blur();
    body.scrollTop = body.scrollHeight;
  }
  input.addEventListener('focus', open);
  document.getElementById('term-shrink')!.addEventListener('click', shrink);
  section.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !vim && !pending) { e.preventDefault(); shrink(); } });
  vv?.addEventListener('resize', fit);
  vv?.addEventListener('scroll', fit);

  // ---- Start ----
  boot();
  refresh();
</script>

<!-- Global: most of the terminal is built at runtime, so Astro's scoped selectors would miss it. Every rule is under .term. -->
<style is:global>
  .term { margin-top: 2.5rem; border: 1px solid var(--faint); border-radius: 10px; overflow: hidden; background: var(--card); font: .85rem/1.55 var(--mono); font-variant-ligatures: none; }
  /* In the page it's a single prompt line; it opens full screen when clicked. */
  .term:not(.full) { border-radius: 8px; cursor: text; transition: border-color .15s; }
  .term:not(.full):hover { border-color: rgb(var(--accent-rgb) / .5); }
  .term:not(.full) .term-bar, .term:not(.full) #term-out, .term:not(.full) .term-chips { display: none; }
  .term:not(.full) .term-body { height: auto; overflow: hidden; padding: .55rem .9rem; }
  .term-hint { display: none; color: var(--muted); white-space: nowrap; font-size: .78rem; }
