---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Entry, excerpt, fmtDate, readingTime, isShort, href } from '../lib';

const { entry, newer, older } = Astro.props as { entry: Entry; newer?: Entry; older?: Entry };
const { Content } = await render(entry);
const label = (e: Entry) => e.data.title ?? excerpt(e, 48);
---
<Base title={entry.data.title ?? excerpt(entry, 60)} description={excerpt(entry, 160)} ogType="article" published={entry.data.date}>
  <article>
    <header class="post-head">
      {entry.data.title && <h1>{entry.data.title}</h1>}
      <div class="meta">
        <time datetime={entry.data.date.toISOString()}>{fmtDate(entry.data.date)}</time>
        {!isShort(entry) && <span> · {readingTime(entry)}</span>}
        {entry.data.draft && <span class="tag-draft"> · draft (not published)</span>}
      </div>
    </header>
    <div class="prose"><Content /></div>
    {entry.data.tags.length > 0 && (
      <p class="tags">{entry.data.tags.map((t) => <a class="tag" href={`/?tag=${t}`}>{t}</a>)}</p>
    )}
  </article>
  <nav class="post-foot">
    {older ? <a href={href(older)}>← {label(older)}</a> : <a href="/">← everything</a>}
    {newer ? <a href={href(newer)}>{label(newer)} →</a> : <span />}
  </nav>
</Base>
