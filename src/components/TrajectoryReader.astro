---
// The trajectory reader. Rendered at /trajectories/ and once per stored run at /trajectories/<key>/;
// everything else happens client-side in src/scripts/trajectories/.
import Base from '../layouts/Base.astro';

interface Props { library: unknown[]; initial?: string; title?: string; description?: string }
const { library, initial, title = 'Trajectories', description = 'A reader for AI agent trajectories: run results (.json) next to their event streams (.jsonl) from Codex CLI, Claude Code, Cursor and Antigravity.' } = Astro.props;
const libraryJson = JSON.stringify(library).replace(/</g, '\\u003c');
---
<Base title={title} description={description} sheep={false}>
  <div class="tr" data-initial={initial}>
    <script type="application/json" id="tr-library" set:html={libraryJson} />

    <section id="tr-home" class="tr-home" hidden>
      <header class="tr-pagehead">
        <h1>Trajectories</h1>
        <p>Agent runs, step by step: each run’s result <code>.json</code> alongside its event stream <code>.jsonl</code>. Reads Codex CLI, Claude Code, Cursor and Antigravity streams.</p>
      </header>

      <div class="tr-drop">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 10.5V2.5M4.5 6 8 2.5 11.5 6M2.5 10v3.5h11V10" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Open your own run: drop <code>.json</code> / <code>.jsonl</code> files or a results folder anywhere on the page. Files stay in your browser.</span>
        <span class="spacer"></span>
        <button type="button" class="tr-btn" data-pick="files">Choose files</button>
        <button type="button" class="tr-btn" data-pick="dir">Choose folder</button>
        <button type="button" class="tr-btn" id="tr-paste-btn">Paste</button>
      </div>
      <div id="tr-paste" class="tr-paste" hidden>
        <textarea id="tr-paste-text" rows="5" spellcheck="false" aria-label="JSON or JSONL to read" placeholder="Paste a summary JSON or a JSONL event stream"></textarea>
        <div><button type="button" class="tr-btn primary" id="tr-paste-go">Read</button> <button type="button" class="tr-btn" id="tr-paste-cancel">Cancel</button></div>
      </div>
      <p class="tr-status" id="tr-status" role="status"></p>

      <section id="tr-local" class="tr-section" hidden>
        <div class="tr-sechead">
          <h2>Opened locally</h2><span class="tr-count" id="tr-local-meta"></span>
          <span class="spacer"></span>
          <button type="button" class="tr-link" data-clear>Clear</button>
        </div>
        <div class="tr-tablewrap"><table class="tr-table"><thead id="tr-local-head"></thead><tbody id="tr-local-rows"></tbody></table></div>
      </section>

      <section id="tr-lib" class="tr-section">
        <div class="tr-sechead">
          <h2>Library</h2><span class="tr-count" id="tr-lib-meta"></span>
          <span class="spacer"></span>
          <input type="search" id="tr-run-filter" class="tr-input" placeholder="Filter runs" autocomplete="off" aria-label="Filter runs" />
        </div>
        <div class="tr-tablewrap"><table class="tr-table"><thead id="tr-lib-head"></thead><tbody id="tr-lib-rows"></tbody></table></div>
        <p class="tr-empty" id="tr-lib-empty" hidden>No stored runs yet.</p>
      </section>
    </section>

    <section id="tr-run" hidden>
      <nav class="tr-crumbs" aria-label="Breadcrumb">
        <a href="/trajectories/" id="tr-home-link">Trajectories</a>
        <span class="sep">/</span>
        <span id="tr-crumb" class="cur"></span>
        <span class="spacer"></span>
        <span id="tr-runnav" class="tr-runnav"></span>
      </nav>
      <header id="tr-runhead" class="tr-runhead"></header>
      <div id="tr-panel" class="tr-panel"></div>

      <div id="tr-toolbar" class="tr-toolbar">
        <div class="tr-tools">
          <div class="tr-searchbox">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            <input type="search" id="tr-q" placeholder="Search steps, output, messages" autocomplete="off" spellcheck="false" aria-label="Search the trajectory" />
            <span id="tr-hits" class="tr-hits" aria-live="polite"></span>
            <button type="button" id="tr-prev" class="tr-icon" aria-label="Previous match" title="Previous match (Shift+Enter)">↑</button>
            <button type="button" id="tr-next" class="tr-icon" aria-label="Next match" title="Next match (Enter)">↓</button>
          </div>
          <div class="tr-filters" id="tr-chips"></div>
          <span class="spacer"></span>
          <label class="tr-check"><input type="checkbox" id="tr-grouped" /> Group steps</label>
          <button type="button" id="tr-expand" class="tr-btn sm">Expand all</button>
        </div>
        <div class="tr-mapwrap"><canvas id="tr-map" aria-label="Overview of the run; click to jump"></canvas><div id="tr-map-cursor"></div></div>
      </div>

      <div class="tr-body">
        <nav id="tr-outline" class="tr-outline" aria-label="Messages"><p class="tr-outline-title">Messages</p><ol id="tr-outline-list"></ol></nav>
        <div id="tr-events" class="tr-events"></div>
      </div>
      <p class="tr-keys"><kbd>/</kbd> search <kbd>Enter</kbd> next match <kbd>j</kbd> <kbd>k</kbd> next / previous message <kbd>[</kbd> <kbd>]</kbd> previous / next run</p>
    </section>

    <input type="file" id="tr-files" multiple accept=".json,.jsonl,.ndjson,.log,.txt,.gz" hidden />
    <input type="file" id="tr-dir" webkitdirectory hidden />
    <div class="tr-dropzone" aria-hidden="true"><span>Drop to open</span></div>
  </div>

  <script>
    import '../scripts/trajectories/main.js';
  </script>
</Base>

<style is:global>
  /* Page chrome: a working tool, so tighter than the rest of the site. */
  body:has(.tr) .wrap { max-width: 76rem; }
  body.tr-reading .wrap { max-width: 100rem; }
  body:has(.tr) .site-header { padding: 1.1rem 0 1.4rem; }
  body:has(.tr) .site-footer { margin: 4rem auto 1.5rem; font-size: .78rem; }

  .tr {
    --ok: #2f8a4c; --gut: 4.6rem; --line: var(--faint); --hover: rgb(127 127 127 / .07);
    font: 400 13px/1.5 var(--sans); color: var(--fg); font-feature-settings: 'tnum' 1, 'cv11' 1;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .tr { --ok: #5cb87a; } }
  :root[data-theme='dark'] .tr { --ok: #5cb87a; }
  .tr [hidden] { display: none !important; }
  .tr .spacer { flex: 1; }
  .tr code { font: 11.5px var(--mono); background: var(--card); padding: .05em .35em; border-radius: 3px; }
  .tr h1, .tr h2 { font-family: var(--sans); letter-spacing: -.01em; }

  /* controls */
  .tr-btn { font: 500 12px/1 var(--sans); color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 6px 10px; cursor: pointer; white-space: nowrap; }
  .tr-btn:hover { background: var(--hover); }
  .tr-btn.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .tr-btn.sm { padding: 4px 8px; font-size: 11.5px; }
  .tr-btn:disabled { opacity: .4; cursor: default; }
  .tr-link { all: unset; cursor: pointer; font-size: 12px; color: var(--muted); }
  .tr-link:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 2px; }
  .tr-icon { font: 12px/1 var(--sans); color: var(--muted); background: none; border: 0; border-radius: 4px; width: 22px; height: 22px; cursor: pointer; }
  .tr-icon:hover { background: var(--hover); color: var(--fg); }
  .tr-input { font: 12.5px var(--sans); color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 5px 9px; outline: none; width: 14rem; }
  .tr-input:focus, .tr-searchbox:focus-within { border-color: rgb(var(--accent-rgb) / .7); }
  .tr-check { display: inline-flex; gap: 6px; align-items: center; font-size: 12px; color: var(--muted); cursor: pointer; white-space: nowrap; }
  .tr-check input { margin: 0; accent-color: var(--fg); }
  .tr kbd { font: 10.5px var(--mono); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 4px; padding: 0 4px; margin: 0 2px; }

  /* home */
  .tr-pagehead h1 { font-size: 20px; font-weight: 600; margin: 0 0 4px; }
  .tr-pagehead p { margin: 0 0 18px; color: var(--muted); max-width: 46rem; }
  .tr-drop { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; border: 1px dashed var(--line); border-radius: 8px; padding: 10px 12px; color: var(--muted); font-size: 12.5px; }
  .tr-drop svg { width: 16px; height: 16px; flex: none; }
  .tr-drop > span:not(.spacer) { flex: 1 1 22rem; }
  .tr-paste { margin-top: 8px; }
  .tr-paste textarea { width: 100%; font: 11.5px var(--mono); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); resize: vertical; margin-bottom: 6px; }
  .tr-status { margin: 8px 0 0; font-size: 12px; color: var(--muted); min-height: 1em; }
  .tr-section { margin-top: 28px; }
  .tr-sechead { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .tr-sechead h2 { font-size: 13px; font-weight: 600; margin: 0; }
  .tr-count { font-size: 12px; color: var(--muted); }
  .tr-empty { color: var(--muted); font-size: 12.5px; padding: 18px 0; margin: 0; border-top: 1px solid var(--line); }

  /* tables */
  .tr-tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
  .tr-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .tr-table th { text-align: left; font: 500 11px var(--sans); color: var(--muted); padding: 7px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; background: var(--card); }
  .tr-table th button { all: unset; cursor: pointer; }
  .tr-table th button:hover, .tr-table th button.on { color: var(--fg); }
  .tr-table th.r, .tr-table td.r { text-align: right; }
  /* Same column widths in both tables so they line up. */
  .tr-table th:nth-child(2) { width: 7rem; } .tr-table th:nth-child(3) { width: 10rem; } .tr-table th:nth-child(4) { width: 4.5rem; }
  .tr-table th:nth-child(5) { width: 8rem; } .tr-table th:nth-child(6) { width: 4.5rem; } .tr-table th:nth-child(7) { width: 5.5rem; } .tr-table th:nth-child(8) { width: 4.5rem; }
  .tr-table td { padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; white-space: nowrap; }
  .tr-table tbody tr:last-child td { border-bottom: 0; }
  .tr-table tbody tr { cursor: pointer; }
  .tr-table tbody tr:hover, .tr-table tbody tr:focus-within { background: var(--hover); }
  .tr-table td.run { white-space: normal; min-width: 16rem; }
  .tr-table td.run a { text-decoration: none; font-weight: 500; overflow-wrap: anywhere; }
  .tr-table td.run small { display: block; color: var(--muted); font: 11px var(--mono); overflow-wrap: anywhere; }
  .tr-table td.mono { font: 11.5px var(--mono); }
  .tr-table td.dim { color: var(--muted); }

  /* status pills */
  .tr-pill { display: inline-flex; align-items: center; gap: 5px; font: 500 11px/1 var(--sans); padding: 3px 7px; border-radius: 99px; border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }
  .tr-pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .tr-pill.solved { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 35%, transparent); }
  .tr-pill.failed { color: var(--accent); border-color: rgb(var(--accent-rgb) / .35); }
  .tr-pill.none::before { display: none; }

  /* run header */
  .tr-crumbs { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); margin-bottom: 10px; flex-wrap: wrap; }
  .tr-crumbs a { text-decoration: none; }
  .tr-crumbs a:hover { color: var(--fg); }
  .tr-crumbs .cur { color: var(--fg); overflow-wrap: anywhere; }
  .tr-runnav { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .tr-runnav .pos { font-variant-numeric: tabular-nums; }
  .tr-runhead h1 { font-size: 18px; font-weight: 600; margin: 0; overflow-wrap: anywhere; }
  .tr-titlerow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .tr-sub { margin: 4px 0 0; color: var(--muted); font-size: 12px; display: flex; flex-wrap: wrap; gap: 2px 0; }
  .tr-sub span + span::before { content: '·'; margin: 0 7px; opacity: .6; }
  .tr-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); margin: 14px 0 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .tr-metrics > div { padding: 8px 12px; border-right: 1px solid var(--line); margin-right: -1px; min-width: 0; }
  .tr-metrics dt { font-size: 11px; color: var(--muted); }
  .tr-metrics dd { margin: 1px 0 0; font-size: 15px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tr-metrics dd small { font-size: 11px; font-weight: 400; color: var(--muted); }
  .tr-metrics .bad dd { color: var(--accent); }
  .tr-metrics .good dd { color: var(--ok); }

  /* tabbed panel: final message / result / config */
  .tr-panel { margin-top: 14px; border: 1px solid var(--line); border-radius: 8px; }
  .tr-panel:empty { display: none; }
  .tr-tabs { display: flex; align-items: stretch; gap: 2px; border-bottom: 1px solid var(--line); padding: 0 6px; overflow-x: auto; }
  .tr-tabs button.tab { all: unset; cursor: pointer; font-size: 12px; color: var(--muted); padding: 8px 8px 7px; border-bottom: 2px solid transparent; white-space: nowrap; }
  .tr-tabs button.tab:hover { color: var(--fg); }
  .tr-tabs button.tab[aria-selected='true'] { color: var(--fg); border-bottom-color: var(--fg); font-weight: 500; }
  .tr-tabs .tr-link { align-self: center; padding: 0 6px; font-size: 11.5px; }
  .tr-panel.collapsed .tr-tabs { border-bottom: 0; }
  .tr-panel.collapsed .tr-panebody { display: none; }
  .tr-panebody { padding: 12px 14px; max-height: 22rem; overflow: auto; }
  .tr-panebody .note { margin: 0 0 8px; font-size: 11.5px; color: var(--muted); }

  /* JSON explorer */
  .j-obj { display: grid; grid-template-columns: minmax(5rem, max-content) minmax(0, 1fr); gap: 2px 14px; margin: 0; font-size: 12px; }
  .j-obj dt { font: 11.5px var(--mono); color: var(--muted); }
  .j-obj dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .j-row { grid-column: 1 / -1; }
  .j-node > summary { cursor: pointer; font: 11.5px var(--mono); color: var(--muted); }
  .j-node > summary:hover { color: var(--fg); }
  .j-node > :not(summary) { margin: 3px 0 5px 14px; }
  .j-str, .j-num, .j-null, .j-sep, .j-bool, .j-key { font: 11.5px var(--mono); }
  .j-null, .j-sep, .j-key { color: var(--muted); }
  .j-bool.true { color: var(--ok); }
  .j-bool.false { color: var(--accent); }
  .j-inline { display: inline-flex; flex-wrap: wrap; gap: 0 14px; }
  .j-pre, .j-long pre { font: 11px/1.5 var(--mono); background: var(--card); padding: 6px 9px; border-radius: 5px; margin: 2px 0; overflow: auto; max-height: 18rem; }
  .j-long summary { cursor: pointer; }
  .j-table { border-collapse: collapse; font: 11.5px var(--mono); margin: 2px 0; }
  .j-table th, .j-table td { border-bottom: 1px solid var(--line); padding: 2px 14px 2px 0; text-align: left; vertical-align: top; }
  .j-table thead th, .j-table tbody th { color: var(--muted); font-weight: 400; }
  .tr .tbl { overflow-x: auto; }

  /* toolbar */
  .tr-toolbar { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 10px 0 8px; margin-top: 18px; border-bottom: 1px solid var(--line); }
  .tr-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .tr-searchbox { display: flex; align-items: center; gap: 4px; border: 1px solid var(--line); border-radius: 6px; padding: 0 4px 0 8px; height: 28px; flex: 0 1 20rem; min-width: 12rem; color: var(--muted); }
  .tr-searchbox svg { width: 13px; height: 13px; flex: none; }
  .tr-searchbox input { all: unset; flex: 1; min-width: 0; font-size: 12.5px; color: var(--fg); }
  .tr-searchbox input::-webkit-search-cancel-button { display: none; }
  .tr-hits { font-size: 11px; white-space: nowrap; }
  .tr-filters { display: flex; flex-wrap: wrap; gap: 4px; }
  .tr-chip { font: 11.5px/1 var(--sans); color: var(--muted); background: none; border: 1px solid var(--line); border-radius: 5px; padding: 4px 7px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .tr-chip:hover { color: var(--fg); }
  .tr-chip i { width: 7px; height: 7px; border-radius: 2px; background: currentColor; opacity: .25; }
  .tr-chip b { font-weight: 400; color: var(--muted); }
  .tr-chip[aria-pressed='true'] { color: var(--fg); background: var(--card); }
  .tr-chip[aria-pressed='true'] i { opacity: 1; background: var(--dot, var(--fg)); }
  .tr-chip.fail[aria-pressed='true'] { color: var(--accent); border-color: rgb(var(--accent-rgb) / .45); }
  .tr-mapwrap { position: relative; height: 18px; margin-top: 8px; }
  #tr-map { width: 100%; height: 18px; display: block; cursor: pointer; border-radius: 0; }
  #tr-map-cursor { position: absolute; top: -2px; bottom: -2px; display: none; pointer-events: none; border: 1px solid var(--fg); border-radius: 2px; min-width: 3px; }
  @media (max-width: 640px) {
    .tr-filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; max-width: 100%; }
    .tr-searchbox { flex-basis: 100%; }
  }

  /* layout */
  .tr-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 12px; }
  .tr-outline { display: none; }
  @media (min-width: 1100px) {
    .tr-body { grid-template-columns: 15rem minmax(0, 1fr); }
    .tr-outline:not([hidden]) { display: block; position: sticky; top: calc(var(--tr-tb, 6rem) + 12px); max-height: calc(100vh - var(--tr-tb, 6rem) - 24px); overflow-y: auto; align-self: start; scrollbar-width: thin; }
  }
  .tr-outline-title { font-size: 11px; color: var(--muted); margin: 0 0 6px; padding-left: 10px; }
  .tr-outline ol { list-style: none; margin: 0; padding: 0; }
  .tr-outline li button { all: unset; cursor: pointer; display: block; font-size: 12px; line-height: 1.4; color: var(--muted); padding: 4px 8px; border-left: 2px solid var(--line); overflow-wrap: anywhere; }
  .tr-outline li button:hover { color: var(--fg); background: var(--hover); }
  .tr-outline .at { font: 10.5px var(--mono); margin-right: 6px; opacity: .7; }
  .tr-outline li.active button { color: var(--fg); border-left-color: var(--fg); }
  .tr-outline li.hit button { box-shadow: inset 2px 0 0 var(--accent); }
  .tr-outline li.k-plan button { color: var(--ok); }
  .tr-outline li.k-error button { color: var(--accent); }

  /* timeline: a gutter (who / which steps) and the content */
  .tr-events { display: flex; flex-direction: column; min-width: 0; }
  .tr-events > *, .tr-step { scroll-margin-top: calc(var(--tr-tb, 6rem) + 12px); }
  .tr-row { display: grid; grid-template-columns: var(--gut) minmax(0, 1fr); gap: 0 12px; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .tr-row > .gut { font: 11px/1.9 var(--mono); color: var(--muted); text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tr-row > .cnt { min-width: 0; }
  .tr-row.k-message .cnt { font-size: 13.5px; line-height: 1.6; max-width: 52rem; }
  .tr-row.k-reasoning .cnt { color: var(--muted); font-style: italic; max-width: 52rem; }
  .tr-row.k-user .cnt { max-width: 52rem; }
  .tr-row.k-user .gut, .tr-row.k-message .gut { color: var(--fg); }
  .tr-row.k-plan .gut { color: var(--ok); }
  .tr-row.k-plan ul { list-style: none; margin: 0; padding: 0; font-size: 12.5px; }
  .tr-row.k-plan li { display: flex; gap: 7px; }
  .tr-row.k-plan li::before { content: ''; flex: none; width: 9px; height: 9px; margin-top: 4px; border: 1px solid var(--muted); border-radius: 2px; }
  .tr-row.k-plan li.done { color: var(--muted); }
  .tr-row.k-plan li.done::before { background: var(--ok); border-color: var(--ok); }
  .tr-row.k-error .gut { color: var(--accent); }
  .tr-row.k-error pre { font: 11.5px/1.5 var(--mono); white-space: pre-wrap; margin: 2px 0 0; overflow-wrap: anywhere; color: var(--accent); }
  .tr-row.k-marker .cnt { font: 11px var(--mono); color: var(--muted); }
  .tr-row.sub .cnt { padding-left: 10px; border-left: 2px dotted var(--line); }
  .tr-row.hit > .gut { box-shadow: inset -2px 0 0 var(--accent); }
  .tr-row.clamped .cnt { max-height: 11rem; overflow: hidden; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
  .tr-row .more { grid-column: 2; justify-self: start; margin-top: 4px; }

  .md > :first-child { margin-top: 0; }
  .md > :last-child { margin-bottom: 0; }
  .md p, .md ul, .md ol { margin: 0 0 7px; }
  .md ul, .md ol { padding-left: 18px; }
  .md li { margin: 1px 0; }
  .md li.nested { margin-left: 16px; }
  .md h3, .md h4, .md h5, .md h6 { font-size: 13px; font-weight: 600; margin: 10px 0 4px; font-family: var(--sans); }
  .md pre { font: 11.5px/1.5 var(--mono); background: var(--card); padding: 7px 10px; border-radius: 5px; overflow-x: auto; font-style: normal; }
  .md pre code { background: none; padding: 0; }
  .md blockquote { margin: 0 0 7px; padding-left: 10px; border-left: 2px solid var(--line); color: var(--muted); }
