---
import { type Entry, excerpt, fmtDate, readingTime, href } from '../lib';
const { entry, brief = false } = Astro.props as { entry: Entry; brief?: boolean };
---
<li class="entry">
  <div class="meta">
    <time datetime={entry.data.date.toISOString()}>{fmtDate(entry.data.date)}</time>
    <span>· {readingTime(entry)}</span>
    {entry.data.draft && <span class="tag-draft">· draft</span>}
  </div>
  <h2><a href={href(entry)}>{entry.data.title}</a></h2>
  {!brief && <p class="excerpt">{excerpt(entry)}</p>}
</li>
