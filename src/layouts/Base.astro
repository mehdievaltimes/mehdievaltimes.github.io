---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site } from '../lib';

interface Props { title?: string; description?: string; sheep?: boolean; noindex?: boolean; ogType?: string; published?: Date }
const { title, description = site.description, sheep = true, noindex = false, ogType = 'website', published } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ['/writing', 'writing'],
  ['/reading', 'reading'],
  ['/demos', 'sandbox'],
  ['/puppy-bench', 'puppy bench'],
];
const current = (href: string) =>
  href === '/writing' ? path === href || path.startsWith('/posts') : path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" href="/img/favicon-64.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/img/avatar.png" />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:image" content={new URL('/img/og.png', Astro.site)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/img/og.png', Astro.site)} />
    <meta name="theme-color" content="#011627" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GCWJMRKY64"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date()); gtag('config', 'G-GCWJMRKY64');
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      url: Astro.site?.href,
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Columbia University' },
      sameAs: [
        'https://github.com/mehdievaltimes',
        'https://www.linkedin.com/in/mehdisha',
      ],
    })} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="site-header">
        <a class="logo" href="/">{site.short}<span>.</span></a>
        <nav>
          {nav.map(([href, label]) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>
          ))}
          <button class="theme-btn" id="theme-btn" aria-label="Toggle dark mode">◐</button>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="links">
          {sheep && <button class="linkish" id="call-sheep-home" onclick="window.toggleSheepHome && window.toggleSheepHome()">send the sheep home</button>}
          <a href="https://github.com/mehdievaltimes" rel="me">github</a>
          <a href="https://www.linkedin.com/in/mehdisha" rel="me">linkedin</a>
          <a href="https://instagram.com/mehdievaltimes">instagram</a>
          <span>{site.email}</span>
        </span>
      </footer>
    </div>
    <script is:inline>
      document.getElementById('theme-btn').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== 'light';
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
    {sheep && <script is:inline src="/js/sheep.js"></script>}
  </body>
</html>
