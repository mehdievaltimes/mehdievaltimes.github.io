---
import Base from '../layouts/Base.astro';
---
<Base title="A wafer-thin mint" sheep={false} noindex>
  <header class="post-head">
    <h1>A wafer-thin mint?</h1>
    <p class="meta">Oh sir, it&rsquo;s only wafer thin. (Columbia / Barnard only.)</p>
  </header>
  <div class="card demo">
    <div id="out"><button id="signin">Just one, sir</button></div>
    <p class="meta" id="msg"></p>
  </div>
</Base>

<script>
  import { initializeApp } from 'firebase/app';
  import { getAuth, GoogleAuthProvider, signInWithPopup, signOut } from 'firebase/auth';
  import { getFirestore, doc, getDoc, setDoc, serverTimestamp } from 'firebase/firestore';

  // Public by design (see the CTF repo README). Paste from Firebase > Project settings > Your apps.
  const app = initializeApp({
    apiKey: 'AIzaSyA28heB-dk12mFoMZA4AKV0lPvQHaFSiAU',
    authDomain: 'ctf-security-e6e33.firebaseapp.com',
    projectId: 'ctf-security-e6e33',
    appId: '1:303699764243:web:9430387018ff7a82bf0be6',
  });
  const auth = getAuth(app);
  const db = getFirestore(app);
  const $ = (id: string) => document.getElementById(id)!;
  const say = (t: string) => ($('msg').textContent = t);

  $('signin').onclick = async () => {
    try {
      const { user } = await signInWithPopup(auth, new GoogleAuthProvider());
      const email = user.email ?? '';
      if (!/@(columbia|barnard)\.edu$/i.test(email)) {
        await signOut(auth);
        return say('Not on the menu, sir. Columbia or Barnard accounts only.');
      }
      if ((await getDoc(doc(db, 'allowlist', email))).exists()) return say(`${email} has already had the mint. Off you go.`);
      const name = prompt('Your name (as in the class roster)?') ?? '';
      await setDoc(doc(db, 'allowlist', email), { email, name: name.trim().slice(0, 80), at: serverTimestamp() });
      say(`${email} has been served. Thank you, sir. Return to the portal and sign in.`);
    } catch (e) {
      say('Bucket! ' + (e as Error).message);
    }
  };
</script>
