---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../lib';

const key = (w) => [w.data.order, w.data.week ?? 0, w.data.starts?.valueOf() ?? 0];
const weeks = (await getCollection('reading')).sort((a, b) => {
  const [ao, aw, as] = key(a), [bo, bw, bs] = key(b);
  return bo - ao || bw - aw || bs - as;
});
const total = weeks.reduce((n, w) => n + w.data.items.length, 0);
---
<Base title="Reading" description="What I'm reading, by week.">
  <header class="post-head">
    <h1>Reading</h1>
    <p class="meta">{total} item{total === 1 ? '' : 's'} · <span id="read-count">0</span> read · click anything to check it off</p>
  </header>

  {weeks.length === 0 && <p class="excerpt">Nothing here yet.</p>}

  {weeks.map((w) => (
    <section class="week">
      <div class="section-head">
        <h2>{w.data.title ?? `Week ${w.data.week}`}{w.data.course ? ` · ${w.data.course}` : ''}</h2>
        {w.data.starts && <span class="meta">{fmtDate(w.data.starts)}</span>}
      </div>
      {w.data.note && <p class="excerpt">{w.data.note}</p>}
      <ul class="reading">
        {w.data.items.map((it, i) => (
          <li>
            <label>
              <input type="checkbox" data-key={`${w.id}:${i}`} />
              <span class="item">
                <span class="title">
                  {it.url ? <a href={it.url} rel="noopener">{it.title}</a> : it.title}
                  {it.optional && <span class="meta"> · optional</span>}
                </span>
                <span class="meta">{[it.author, it.course, it.note].filter(Boolean).join(' · ')}</span>
              </span>
            </label>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <script is:inline>
    const KEY = 'reading-done';
    let done = {};
    try { done = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
    const boxes = [...document.querySelectorAll('.reading input')];
    const count = () => (document.getElementById('read-count').textContent = String(boxes.filter((b) => b.checked).length));
    boxes.forEach((b) => {
      b.checked = !!done[b.dataset.key];
      b.closest('li').classList.toggle('done', b.checked);
      b.addEventListener('change', () => {
        done[b.dataset.key] = b.checked;
        b.closest('li').classList.toggle('done', b.checked);
        try { localStorage.setItem(KEY, JSON.stringify(done)); } catch {}
        count();
      });
    });
    count();
  </script>
</Base>

<style>
  .week { margin-bottom: 2.5rem; }
  ul.reading { list-style: none; margin: .5rem 0 0; padding: 0; }
  ul.reading li { border-top: 1px solid var(--faint); }
  ul.reading label { display: flex; gap: .7rem; align-items: baseline; padding: .7rem .2rem; cursor: pointer; }
  ul.reading input { accent-color: var(--accent); margin: 0; }
  .item { display: grid; gap: .15rem; }
  .title { font-family: var(--serif); font-size: 1.1rem; }
  li.done .title { opacity: .45; text-decoration: line-through; }
  li.done .meta { opacity: .45; }
</style>
