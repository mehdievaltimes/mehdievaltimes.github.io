---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import { getEntries } from '../../lib';
const posts = await getEntries('posts');
---
<Base title="Posts">
  <header class="post-head"><h1>Posts</h1></header>
  <ul class="feed">{posts.map((entry) => <PostItem entry={entry} />)}</ul>
</Base>
