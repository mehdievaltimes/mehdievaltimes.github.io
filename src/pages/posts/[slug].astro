---
import EntryPage from '../../components/EntryPage.astro';
import { getEntries } from '../../lib';

export async function getStaticPaths() {
  const entries = await getEntries('posts', { includeUnlisted: true });
  const listed = entries.filter((e) => !e.data.unlisted);
  return entries.map((entry) => {
    const i = listed.indexOf(entry);
    return {
      params: { slug: entry.id },
      props: { entry, newer: i > 0 ? listed[i - 1] : undefined, older: i >= 0 ? listed[i + 1] : undefined },
    };
  });
}
---
<EntryPage {...Astro.props} />
