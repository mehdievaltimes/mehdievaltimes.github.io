---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
---
<Base description="Mehdi Shakibapour — math and CS at Columbia. The yearning for AGI keeps me up at night.">
  <section class="about">
    <img class="portrait" src="/img/avatar.webp" alt="Mehdi Shakibapour" width="244" height="256" />
    <div>
      <h1>Mehdi Shakibapour</h1>
      <p class="about-line">Math and Computer Science, Columbia University</p>
      <div class="prose">
        <p>The yearning for AGI keeps me up at night.</p>
      </div>
    </div>
  </section>

  <Terminal />
</Base>

<style>
  .about { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 2rem; align-items: start; }
  .portrait { width: 100%; aspect-ratio: 244 / 256; object-fit: cover; border-radius: 10px; }
  .about h1 { margin: 0 0 .2rem; }
  .about-line { margin: 0 0 1.4rem; color: var(--muted); font-size: .95rem; }

  @media (max-width: 36rem) {
    .about { grid-template-columns: 1fr; gap: 1.25rem; }
    .portrait { width: 7.5rem; }
  }
</style>
