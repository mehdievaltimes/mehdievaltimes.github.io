---
import Base from '../../layouts/Base.astro';
import ThoughtItem from '../../components/ThoughtItem.astro';
import { getEntries } from '../../lib';
const thoughts = await getEntries('thoughts');
---
<Base title="Thoughts">
  <header class="post-head">
    <h1>Thoughts</h1>
    <p class="meta">unpolished, on purpose</p>
  </header>
  <ul class="feed">{thoughts.map((entry) => <ThoughtItem entry={entry} />)}</ul>
</Base>
